# ── Secrets ────────────────────────────────────────────────────────────────
# .env holds OWNER_SEED_PASSWORD and database credentials. The negation must
# stay AFTER the wildcard, or the example file is swallowed by it.
.env
.env.*
# ...but the EXAMPLES are the documentation: names and safe descriptions,
# never values. Committing them is the whole point.
!.env.*.example
!.env.example

# ── Dependencies & build output ────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo

# ── Test & coverage output ─────────────────────────────────────────────────
coverage/
.nyc_output/
junit.xml

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Database dumps & local data ────────────────────────────────────────────
# Dumps contain live business data (IMEIs, costs, customers) and must never be
# committed. Backups belong outside the repository — see docs/22.
*.sql.gz
*.dump
*.bak
dumps/
backups/
# NOTE: prisma/migrations/**/*.sql and prisma/sql/** are SCHEMA, not data, and
# are deliberately NOT ignored.

# ── Temporary files ────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.pid
*.seed

# ── Editor & OS artifacts ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Staging secrets. Only the example is committed.
.env.staging

# Local staging launcher, carries generated secrets.
staging-server.cjs

# Local-disk storage (receipts, photos). User data: never committed.
/uploads/
