  inventoryValue  Decimal      @map("inventory_value") @db.Decimal(14, 2)
  expectedRevenue Decimal      @map("expected_revenue") @db.Decimal(14, 2)
  expectedProfit  Decimal      @map("expected_profit") @db.Decimal(14, 2)
  refreshedAt     DateTime     @map("refreshed_at") @db.DateTime(6)

  @@unique([companyId, branchId, productId])
  @@map("inventory_valuation")
}

// ─────────────────────── OTP & verification intent (F1 Stage 4A) ────────────

/// What a one-time code is for. The purpose is part of the challenge identity,
/// so a code issued to verify a phone can never be replayed to trust a device.
enum OtpPurpose {
  /// Confirming a phone number the user is adding or changing.
  phone_verification

  /// A sign-in from a device the server does not recognise (Stage 4B gates on this).
  device_verification

  /// Signing in again on a device after an explicit logout asked for re-verification.
  logout_reauth
}

/// Terminal and non-terminal states of a challenge. A challenge leaves `pending`
/// exactly once — every transition is conditional on the current state, so two
/// concurrent verifications cannot both win.
enum OtpStatus {
  pending
  verified
  expired
  cancelled
  /// Too many wrong attempts. Distinct from `cancelled` so support can tell a
  /// user "you locked it" from "the system replaced it".
  locked
}

/// Why a delivery attempt did not reach the destination. Mirrors the messaging
/// boundary's failure classes; kept as a column so support can answer "did it
/// even send?" without reading provider logs.
enum OtpDeliveryState {
  /// Created but never handed to a channel.
  not_sent
  /// The channel accepted it. NOT proof the user received it.
  accepted
  /// No provider configured for this deployment.
  channel_unavailable
  /// Provider refused: bad number, unapproved template, opted out.
  rejected
  /// Network/timeout/5xx. A new controlled attempt may be made.
  temporary_failure
  not_authorized
}

/// A one-time code challenge.
///
/// The code itself is NEVER here. `codeHash` is an HMAC-SHA256 over the code
/// keyed by a server-side pepper that lives in configuration, not in the
/// database — six digits is ~20 bits, so an unkeyed hash in a stolen dump falls
/// to a laptop in milliseconds, while a peppered one is useless without the key.
///
/// One effective challenge per (user, purpose, device) is enforced by a partial
/// uniqueness pattern: `activeKey` is set while pending and NULL once the
/// challenge reaches a terminal state, so MySQL's "NULLs do not collide" rule
/// gives a real database guarantee instead of an application-level promise.
model OtpChallenge {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)

  purpose OtpPurpose

  /// The device this challenge is about, when the purpose concerns one. Null
  /// for phone verification, which is about a number rather than a handset.
  deviceId Bytes? @map("device_id") @db.Binary(16)

  /// The destination AS IT WAS when the challenge was created. Snapshotted so a
  /// later phone change cannot retarget a live challenge, and so support can see
  /// where a code actually went.
  destination String @db.VarChar(24)

  /// For `phone_verification`: the candidate number being proven. Verification
  /// only writes `User.phoneVerifiedAt` when this still matches the user's
  /// current phone, so changing the number mid-flight invalidates the proof.
  candidatePhone String? @map("candidate_phone") @db.VarChar(24)

  /// HMAC-SHA256(code, pepper). Never the code. Never reversible.
  codeHash String @map("code_hash") @db.VarChar(128)

  status OtpStatus @default(pending)

  /// Set while `pending`, cleared on any terminal transition. The UNIQUE index
  /// over it is what makes "only one live challenge" a database fact.
  activeKey String? @map("active_key") @db.VarChar(190)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt DateTime @map("expires_at") @db.DateTime(6)

  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @map("max_attempts")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.DateTime(6)

  sendCount       Int       @default(0) @map("send_count")
  lastSentAt      DateTime? @map("last_sent_at") @db.DateTime(6)
  resendNotBefore DateTime? @map("resend_not_before") @db.DateTime(6)

  verifiedAt  DateTime? @map("verified_at") @db.DateTime(6)
  consumedAt  DateTime? @map("consumed_at") @db.DateTime(6)
  cancelledAt DateTime? @map("cancelled_at") @db.DateTime(6)
  lockedAt    DateTime? @map("locked_at") @db.DateTime(6)

  /// Channel name (`disabled`, `development-log`, later a real adapter) and the
  /// provider's own message id when it gives one. Both safe to store and log.
  provider          String?          @db.VarChar(40)
  providerMessageId String?          @map("provider_message_id") @db.VarChar(120)
  deliveryState     OtpDeliveryState @default(not_sent) @map("delivery_state")
  /// Short, provider-neutral reason. Never a raw provider payload.
  deliveryDetail    String?          @map("delivery_detail") @db.VarChar(200)

  /// Client-supplied request identity, so a retried request reuses the live
  /// challenge instead of sending a second code.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)

  company Company     @relation(fields: [companyId], references: [id])
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  UserDevice? @relation(fields: [deviceId], references: [id])

  @@unique([activeKey])
  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([userId, purpose, status])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// A short-lived, opaque ticket proving "this password was correct, but the
/// device still needs verifying".
///
/// It exists so a new-device sign-in can be continued WITHOUT first issuing an
/// access token — the whole point of Stage 4B. Only the hash is stored, so a
/// leaked table yields nothing usable, and it is single-use and bound to one
/// (company, user, purpose, device) so it cannot be carried anywhere else.
///
/// Stage 4A builds and tests it. Nothing issues one in the production login
/// flow yet: `device_unrecognized` still blocks, unchanged.
model VerificationIntent {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)

  purpose OtpPurpose

  /// The device being verified, when the purpose concerns one.
  deviceId Bytes? @map("device_id") @db.Binary(16)

  /// SHA-256 of the raw token. The token is high-entropy (256 bits), so a plain
  /// digest is sufficient here — unlike the six-digit code, which needs a pepper.
  tokenHash String @unique @map("token_hash") @db.VarChar(128)

  /// The challenge this intent is waiting on, when one exists.
  challengeId Bytes? @map("challenge_id") @db.Binary(16)

  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(6)
  /// Set exactly once, by the transaction that acts on it.
  consumedAt DateTime? @map("consumed_at") @db.DateTime(6)

  company Company     @relation(fields: [companyId], references: [id])
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  UserDevice? @relation(fields: [deviceId], references: [id])

  @@index([companyId])
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_intents")
}

/// The lifecycle of a reviewed return (I2). Deliberately has no "refunded"
/// state: I2 creates a refund OBLIGATION, and confirming that money actually
/// moved is I3.
enum ReturnStatus {
  pending_investigation
  under_review
  approved_refund_due
  rejected
}

/// Who is answerable for the fault. `pending_investigation` is the honest
/// starting value — nobody has looked yet — rather than a default that quietly
/// blames the shop or the customer.
enum ReturnResponsibility {
  pending_investigation
  store_or_product_fault
  customer_damage
  other
}

/// Where the phone physically is. Approval requires `store_holds`.
enum ReturnCustody {
  customer_holds
  store_holds
  handed_back
  retained_hold
}

enum ReturnAdjustmentKind {
  screen_protector
  accessory_retained
  restocking_fee
  other
}

/// A reviewed return request against exactly ONE serialized sale line.
model ReturnRequest {
  id           Bytes @id @db.Binary(16)
  companyId    Bytes @map("company_id") @db.Binary(16)
  branchId     Bytes @map("branch_id") @db.Binary(16)
  saleId       Bytes @map("sale_id") @db.Binary(16)
  saleItemId   Bytes @map("sale_item_id") @db.Binary(16)
  unitId       Bytes @map("unit_id") @db.Binary(16)

  status ReturnStatus @default(pending_investigation)

  // NOTE: the database also carries `claim_key`, a VIRTUAL generated column
  // (NULL when rejected, else 1) with UNIQUE (sale_item_id, claim_key). It
  // enforces "one active claim per sale line" and is deliberately NOT declared
  // here — Prisma does not manage generated columns, and the same is true of
  // `sale_items.active_unit_id` from 0002.

  /// Mandatory. Replaying the key with a DIFFERENT payload is a 409, not a
  /// silent no-op.
  clientUuid        Bytes  @map("client_uuid") @db.Binary(16)
  clientRequestHash String @map("client_request_hash") @db.Char(64)

  requestedById  Bytes?  @map("requested_by") @db.Binary(16)
  requestReason  String  @map("request_reason") @db.VarChar(255)
  conditionNotes String? @map("condition_notes") @db.Text

  responsibility      ReturnResponsibility @default(pending_investigation)
  responsibilityNotes String?              @map("responsibility_notes") @db.VarChar(255)

  custody           ReturnCustody @default(customer_holds)
  custodyReceivedAt DateTime?     @map("custody_received_at") @db.DateTime(6)
  custodyReturnedAt DateTime?     @map("custody_returned_at") @db.DateTime(6)

  /// The I1 policy snapshot as it stood when the request was raised, so a later
  /// settings change cannot alter what this request was judged under.
  policyWindowHours Int       @map("policy_window_hours")
  policyDeadlineAt  DateTime? @map("policy_deadline_at") @db.DateTime(6)
  policyReason      String    @map("policy_reason") @db.VarChar(40)
  requiresException Boolean   @default(false) @map("requires_exception")

  reviewedById    Bytes?    @map("reviewed_by") @db.Binary(16)
  reviewedAt      DateTime? @map("reviewed_at") @db.DateTime(6)
  decidedById     Bytes?    @map("decided_by") @db.Binary(16)
  decidedAt       DateTime? @map("decided_at") @db.DateTime(6)
  decisionReason  String?   @map("decision_reason") @db.Text
  exceptionReason String?   @map("exception_reason") @db.VarChar(255)

  /// Approve versus reject must have exactly one winner.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company     Company  @relation(fields: [companyId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id])
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id])
  unit        Unit     @relation(fields: [unitId], references: [id])
  requestedBy User?    @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("ReturnReviewedBy", fields: [reviewedById], references: [id])
  decidedBy   User?    @relation("ReturnDecidedBy", fields: [decidedById], references: [id])

  adjustments ReturnAdjustment[]
  reversal    ReturnReversal?
  payout      RefundPayout?

  @@unique([companyId, clientUuid])
  @@index([companyId, status])
  @@index([branchId, status])
  @@index([saleId])
  @@index([unitId])
  @@index([requestedById])
  @@map("return_requests")
}

/// An explicit charge withheld from the refund — a consumed screen protector, a
/// retained accessory. Never inferred: accessory linkage cannot be derived from
/// a sale carrying two phones and one accessory line (docs/27 §16.4).
model ReturnAdjustment {
  id              Bytes                @id @db.Binary(16)
  companyId       Bytes                @map("company_id") @db.Binary(16)
  returnRequestId Bytes                @map("return_request_id") @db.Binary(16)
  kind            ReturnAdjustmentKind
  label           String               @db.VarChar(160)
  quantity        Int                  @default(1)
  unitAmount      Decimal              @map("unit_amount") @db.Decimal(14, 2)
  totalAmount     Decimal              @map("total_amount") @db.Decimal(14, 2)
  createdById     Bytes?               @map("created_by") @db.Binary(16)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(6)

  company   Company       @relation(fields: [companyId], references: [id])
  request   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  createdBy User?         @relation("ReturnAdjustmentBy", fields: [createdById], references: [id])

  @@index([returnRequestId])
  @@index([companyId])
  @@map("return_adjustments")
}

/// The immutable money record, written once at approval.
///
/// Append-only for the application account, enforced by database triggers in
/// the same shape as `audit_logs` (0028). Every figure is a SNAPSHOT of the
/// original sale line, so the reversal stays true when catalogue prices and
/// costs move afterwards.
model ReturnReversal {
  id              Bytes @id @db.Binary(16)
  companyId       Bytes @map("company_id") @db.Binary(16)
  branchId        Bytes @map("branch_id") @db.Binary(16)
  saleId          Bytes @map("sale_id") @db.Binary(16)
  saleItemId      Bytes @map("sale_item_id") @db.Binary(16)
  unitId          Bytes @map("unit_id") @db.Binary(16)
  returnRequestId Bytes @map("return_request_id") @db.Binary(16)

  lineRevenue Decimal @map("line_revenue") @db.Decimal(14, 2)
  lineCost    Decimal @map("line_cost") @db.Decimal(14, 2)
  lineMargin  Decimal @map("line_margin") @db.Decimal(14, 2)

  grossRefund     Decimal @map("gross_refund") @db.Decimal(14, 2)
  adjustmentTotal Decimal @default(0) @map("adjustment_total") @db.Decimal(14, 2)
  netRefundDue    Decimal @map("net_refund_due") @db.Decimal(14, 2)

  /// The business date this reversal belongs to — the approval day, never the
  /// sale's day. That is what lets the original day stay untouched.
  approvalDate DateTime @map("approval_date") @db.Date
  approvedById Bytes?   @map("approved_by") @db.Binary(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)

  company    Company       @relation(fields: [companyId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  sale       Sale          @relation(fields: [saleId], references: [id])
  saleItem   SaleItem      @relation(fields: [saleItemId], references: [id])
  unit       Unit          @relation(fields: [unitId], references: [id])
  request    ReturnRequest @relation(fields: [returnRequestId], references: [id])
  approvedBy User?         @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  payout     RefundPayout?

  @@unique([saleItemId])
  @@unique([returnRequestId])
  @@index([branchId, approvalDate])
  @@index([companyId, approvalDate])
  @@map("return_reversals")
}

/// How a refund left the till. `account` means one of the shop's configured
/// receiving accounts — the same channel labels a sale can be taken through.
enum RefundMethod {
  cash
  account
}

/// Two words, deliberately. There is no `paid` or `settled` reachable before a
/// manager or owner confirms, because a state that does not exist cannot be
/// shown by mistake.
enum RefundPayoutStatus {
  reported_pending_confirmation
  confirmed
}

/// One settlement of one approved return (I3).
///
/// The application never moves money: this records what the shop says happened.
/// The REPORT is a claim by whoever handed the cash over; the CONFIRMATION by a
/// manager or owner is the record.
///
/// Deliberately NOT a `Payment`: that model is incoming sale money, its
/// `saleId` is required, and its only consumer counts it as cash received
/// (docs/27 §17).
model RefundPayout {
  id               Bytes @id @db.Binary(16)
  companyId        Bytes @map("company_id") @db.Binary(16)
  branchId         Bytes @map("branch_id") @db.Binary(16)
  returnRequestId  Bytes @map("return_request_id") @db.Binary(16)
  returnReversalId Bytes @map("return_reversal_id") @db.Binary(16)

  status RefundPayoutStatus @default(reported_pending_confirmation)

  /// Copied from the reversal so the payout reads on its own and cannot drift.
  netAmountDue   Decimal @map("net_amount_due") @db.Decimal(14, 2)
  /// What the reporter says was handed over. A CHECK requires it to equal the
  /// amount due — there is no partial payout in I3.
  reportedAmount Decimal @map("reported_amount") @db.Decimal(14, 2)

  method               RefundMethod
  receivingAccountId   Bytes?  @map("receiving_account_id") @db.Binary(16)
  /// Snapshotted at confirmation, so a receipt printed months later still reads
  /// what the employee chose even if the account was later renamed.
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)

  transactionReference String? @map("transaction_reference") @db.VarChar(120)
  note                 String? @db.VarChar(255)

  reportedById  Bytes?    @map("reported_by_id") @db.Binary(16)
  reportedAt    DateTime  @default(now()) @map("reported_at") @db.DateTime(6)
  confirmedById Bytes?    @map("confirmed_by_id") @db.Binary(16)
  confirmedAt   DateTime? @map("confirmed_at") @db.DateTime(6)
  /// The business date the cash movement belongs to — the confirmation day.
  confirmationDate DateTime? @map("confirmation_date") @db.Date

  clientUuid        Bytes  @map("client_uuid") @db.Binary(16)
  clientRequestHash String @map("client_request_hash") @db.Char(64)

  /// Set when a correction supersedes this payout (Milestone B, `0041`).
  ///
  /// A back-reference ONLY. No financial field is ever rewritten — status,
  /// amount, method, who reported and confirmed it, and the receipt it produces
  /// are all unchanged. This exists so a REPLACEMENT payout can be reported
  /// while "one live payout per return" stays a database guarantee rather than
  /// an application check: the unique index sits on a generated column that is
  /// the return id while this is NULL, and NULL once it is set.
  correctedById Bytes? @map("corrected_by_id") @db.Binary(16)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  request          ReturnRequest     @relation(fields: [returnRequestId], references: [id])
  reversal         ReturnReversal    @relation(fields: [returnReversalId], references: [id])
  receivingAccount ReceivingAccount? @relation(fields: [receivingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportedBy       User?             @relation("RefundReportedBy", fields: [reportedById], references: [id])
  confirmedBy      User?             @relation("RefundConfirmedBy", fields: [confirmedById], references: [id])

  correctedBy      FinancialCorrection? @relation("PayoutSupersededBy", fields: [correctedById], references: [id])

  @@unique([returnRequestId])
  @@unique([returnReversalId])
  @@unique([companyId, clientUuid])
  @@index([branchId, status])
  @@index([branchId, confirmationDate])
  @@index([companyId, status])
  @@map("refund_payouts")
  corrections FinancialCorrection[]
}

// ───────────────────────── Supplier settlement (J1) ─────────────────────────

/// Where a settlement is in the two-person workflow.
///
/// `reported` is a CLAIM by whoever handed the money over. Only `confirmed`
/// moves cash, settles liability and reaches reconciliation. There is no third
/// state: a rejected report is deleted while it is still only a claim, and a
/// confirmed one is never edited (see `docs/28` §4).
enum SupplierSettlementStatus {
  reported
  confirmed
}

/// Money paid to a supplier — reported by one person, confirmed by another.
///
/// Deliberately NOT the existing `SupplierPayment`, and deliberately not the
/// I3 `RefundPayout` generalised. A refund is one per return with a locked
/// amount and no allocation; this is many per supplier, partial, and split
/// across several purchases. One table for both would make the amount rule
/// conditional on a type column, which is how invariants stop being enforced.
///
/// The app RECORDS a payment. It moves no money, calls no provider and holds no
/// credential.
model SupplierSettlement {
  id         Bytes  @id @db.Binary(16)
  companyId  Bytes  @map("company_id") @db.Binary(16)
  /// The branch that paid. The debt is company-wide; the till is not.
  branchId   Bytes  @map("branch_id") @db.Binary(16)
  supplierId Bytes  @map("supplier_id") @db.Binary(16)

  status SupplierSettlementStatus @default(reported)
  /// Total handed over. Must equal the sum of its allocations, and may never
  /// exceed what is outstanding — checked against committed rows at confirmation.
  amount Decimal @db.Decimal(14, 2)
  method RefundMethod

  receivingAccountId Bytes? @map("receiving_account_id") @db.Binary(16)
  /// The account label as it read when the settlement was REPORTED, frozen at
  /// confirmation. A later rename must not retitle a movement that happened.
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)

  transactionReference String? @map("transaction_reference") @db.VarChar(120)
  note                 String? @db.VarChar(255)

  /// Optimistic concurrency: two managers confirming one report, one winner.
  version Int @default(0)

  /// Mandatory. An offline retry must not record two payments.
  clientUuid        Bytes  @map("client_uuid") @db.Binary(16)
  clientRequestHash String @map("client_request_hash") @db.Char(64)

  reportedById Bytes?    @map("reported_by") @db.Binary(16)
  reportedAt   DateTime  @default(now()) @map("reported_at") @db.DateTime(6)
  confirmedById Bytes?   @map("confirmed_by") @db.Binary(16)
  confirmedAt   DateTime? @map("confirmed_at") @db.DateTime(6)
  /// The business date the cash movement belongs to — the CONFIRMATION day,
  /// never the report day. That is what reconciliation reads.
  confirmationDate DateTime? @map("confirmation_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company         Company          @relation(fields: [companyId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  receivingAccount ReceivingAccount? @relation(fields: [receivingAccountId], references: [id])
  reportedBy      User?            @relation("SettlementReportedBy", fields: [reportedById], references: [id])
  confirmedBy     User?            @relation("SettlementConfirmedBy", fields: [confirmedById], references: [id])

  allocations SupplierSettlementAllocation[]

  @@unique([companyId, clientUuid])
  @@index([companyId, supplierId, status])
  @@index([companyId, branchId, confirmationDate])
  @@map("supplier_settlements")
  corrections FinancialCorrection[]
}

/// How much of one settlement paid down one purchase.
///
/// Money is never silently spread: the allocation is explicit, returned to the
/// caller, and the only thing that reduces a purchase's outstanding balance.
/// Purchase totals are never rewritten to express payment.
model SupplierSettlementAllocation {
  id           Bytes   @id @db.Binary(16)
  companyId    Bytes   @map("company_id") @db.Binary(16)
  settlementId Bytes   @map("settlement_id") @db.Binary(16)
  purchaseId   Bytes   @map("purchase_id") @db.Binary(16)
  amount       Decimal @db.Decimal(14, 2)

  company    Company            @relation(fields: [companyId], references: [id])
  settlement SupplierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  purchase   Purchase           @relation(fields: [purchaseId], references: [id])

  /// One line per purchase per settlement. Two lines for the same purchase
  /// would let a duplicate slip past an application-level check.
  @@unique([settlementId, purchaseId])
  @@index([companyId, purchaseId])
  @@map("supplier_settlement_allocations")
}

// ───────────────────────────── Financial corrections ─────────────────────────

enum FinancialCorrectionKind {
  refund_payout
  supplier_settlement
}

enum FinancialCorrectionStatus {
  requested
  approved
  rejected
}

/// Undoing a CONFIRMED payment, without rewriting it (Milestone B).
///
/// A confirmed refund payout and a confirmed supplier settlement are both
/// immutable, and nothing financial is hard-deleted — so correcting one cannot
/// mean editing it. It means appending a compensating record here.
///
/// **Nothing is written back to the corrected row.** Both liabilities are
/// already derived from rows whose status is `confirmed`, so an approved
/// correction restores the liability simply by existing: the derivation queries
/// exclude any target that has one. "Restored exactly once" is therefore a
/// property of the schema — enforced by `activeTargetPayoutId` /
/// `activeTargetSettlementId`, the partial-unique trick from `0002` — rather
/// than something the application has to remember to do.
model FinancialCorrection {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  /// The branch whose till the compensating movement lands in — copied from the
  /// original payment, so a correction cannot post against a different drawer.
  branchId  Bytes @map("branch_id") @db.Binary(16)

  targetKind FinancialCorrectionKind @map("target_kind")
  /// Exactly one is set, matching `targetKind`. Two nullable columns rather
  /// than one polymorphic id, so both keep a real foreign key.
  targetRefundPayoutId       Bytes? @map("target_refund_payout_id") @db.Binary(16)
  targetSupplierSettlementId Bytes? @map("target_supplier_settlement_id") @db.Binary(16)

  status FinancialCorrectionStatus @default(requested)

  /// Mandatory. A correction to confirmed money with no stated reason is
  /// indistinguishable from a mistake, months later.
  reason              String  @db.VarChar(255)
  supportingReference String? @map("supporting_reference") @db.VarChar(120)

  /// Copied from the target, never typed. The compensating movement is exactly
  /// the opposite of what was paid, so it cannot disagree with it.
  amount Decimal     @db.Decimal(14, 2)
  method RefundMethod
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)

  requestedById Bytes?    @map("requested_by_id") @db.Binary(16)
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.DateTime(6)
  decidedById   Bytes?    @map("decided_by_id") @db.Binary(16)
  decidedAt     DateTime? @map("decided_at") @db.DateTime(6)
  /// The CURRENT open business day at approval — never the original payment's
  /// day. Old closings stay shut.
  correctionDate DateTime? @map("correction_date") @db.Date

  clientUuid        Bytes  @map("client_uuid") @db.Binary(16)
  clientRequestHash String @map("client_request_hash") @db.Char(64)

  /// Optimistic concurrency: two owners approving one request, one winner.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  targetPayout     RefundPayout?       @relation(fields: [targetRefundPayoutId], references: [id])
  targetSettlement SupplierSettlement? @relation(fields: [targetSupplierSettlementId], references: [id])
  requestedBy User?               @relation("CorrectionRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?               @relation("CorrectionDecidedBy", fields: [decidedById], references: [id])

  supersededPayouts RefundPayout[] @relation("PayoutSupersededBy")

  @@unique([companyId, clientUuid])
  @@index([companyId, status])
  @@index([companyId, branchId, correctionDate])
  @@map("financial_corrections")
}

/// What a goal measures (0047). Each one maps to a figure `daily_rollups`
/// already computes, so a goal can never disagree with the day's analytics.
///
/// Deliberately NO `net_profit`: expenses are not the salesperson's doing, and
/// a target somebody cannot influence is not a goal, it is a grievance.
enum GoalMetric {
  gross_profit
  revenue
  sales_count
  units_sold
}

enum GoalScope {
  company
  branch
  /// One person, within one branch. Somebody working across two shops has two
  /// jobs, and one merged number would hide which is going badly.
  user
}

/// Kept for wording only ("this month"), never for arithmetic — the dates are
/// what the figures are computed from.
enum GoalPeriodLabel {
  daily
  weekly
  monthly
  custom
}

enum GoalStatus {
  active
  /// Archived rather than deleted. A goal that was missed is a fact about the
  /// shop's history, and deleting it would make every past period look met.
  archived
}

/// A target somebody is working toward (Milestone F).
///
/// **Progress is not stored here.** It is derived from `DailyRollup` every time
/// a goal is read — the same rule the employee debt balance follows. A stored
/// progress figure can disagree with the sales it claims to summarise, and it
/// would need invalidating on every sale, return, refund and correction.
model Goal {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)

  scope        GoalScope
  branchId     Bytes? @map("branch_id") @db.Binary(16)
  targetUserId Bytes? @map("target_user_id") @db.Binary(16)

  metric GoalMetric

  /// A real, closed range of days. Storing both dates rather than a period type
  /// plus an offset means a month that started mid-month, or a one-off push
  /// over a holiday week, needs no special case.
  periodStart DateTime        @map("period_start") @db.Date
  periodEnd   DateTime        @map("period_end") @db.Date
  periodLabel GoalPeriodLabel @default(custom) @map("period_label")

  targetAmount Decimal @map("target_amount") @db.Decimal(14, 2)

  status         GoalStatus @default(active)
  /// Mandatory when archiving, like every other decision in this schema.
  archivedReason String?    @map("archived_reason") @db.VarChar(255)

  note String? @db.VarChar(255)

  createdById Bytes    @map("created_by_id") @db.Binary(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  version     Int      @default(0)

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])
  targetUser User?   @relation("GoalTargetUser", fields: [targetUserId], references: [id])
  createdBy  User    @relation("GoalCreatedBy", fields: [createdById], references: [id])

  // Uniqueness is on the generated `active_key` (0047), because MySQL has no
  // partial unique index and two ACTIVE goals for the same person, metric and
  // period would make "am I on target" have two answers.
  @@index([companyId, branchId, status, periodEnd], map: "ix_goals_lookup")
  @@index([companyId, targetUserId, status], map: "ix_goals_user")
  @@index([createdById])
  @@map("goals")
}

// ------------------------- Inter-store consignment (0049) -------------------

/// Where a connection between two shops stands.
enum StoreConnectionStatus {
  pending
  accepted
  rejected
  /// Stops NEW requests. Never deletes history, never erases a liability — a
  /// shop cannot escape what it owes by blocking the creditor.
  blocked
}

/// The trust relationship between two companies.
///
/// One row per pair whichever way round it was requested, enforced by the
/// generated `pair_key` — without it two shops could each hold a pending
/// request to the other and neither could accept cleanly.
model StoreConnection {
  id Bytes @id @db.Binary(16)

  requesterCompanyId Bytes @map("requester_company_id") @db.Binary(16)
  addresseeCompanyId Bytes @map("addressee_company_id") @db.Binary(16)

  status StoreConnectionStatus @default(pending)

  /// Either side may block, so who did it is recorded — otherwise the blocked
  /// party could simply unblock themselves.
  blockedByCompanyId Bytes?    @map("blocked_by_company_id") @db.Binary(16)
  blockedAt          DateTime? @map("blocked_at") @db.DateTime(6)
  blockReason        String?   @map("block_reason") @db.VarChar(255)

  requestedById Bytes?    @map("requested_by_id") @db.Binary(16)
  decidedById   Bytes?    @map("decided_by_id") @db.Binary(16)
  decidedAt     DateTime? @map("decided_at") @db.DateTime(6)
  note          String?   @db.VarChar(255)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  requesterCompany Company  @relation("ConnectionRequester", fields: [requesterCompanyId], references: [id])
  addresseeCompany Company  @relation("ConnectionAddressee", fields: [addresseeCompanyId], references: [id])
  blockedByCompany Company? @relation("ConnectionBlockedBy", fields: [blockedByCompanyId], references: [id])
  requestedBy      User?    @relation("ConnectionRequestedBy", fields: [requestedById], references: [id])
  decidedBy        User?    @relation("ConnectionDecidedBy", fields: [decidedById], references: [id])

  counterparties Counterparty[]
  consignments   Consignment[]

  @@index([requesterCompanyId, status])
  @@index([addresseeCompanyId, status])
  @@index([blockedByCompanyId])
  @@index([requestedById])
  @@index([decidedById])
  @@map("store_connections")
}

/// What kind of party is on the other side.
enum CounterpartyKind {
  connected_store
  manual_store
  manual_person
  /// Milestone I only.
  employee
}

/// Who the other party is, from ONE company's point of view.
///
/// Tenant-scoped, and deliberately shared with Milestone I: a loan and a
/// consignment can be against the same shop or the same person, and duplicating
/// the concept would make "who owes us money" two different lists.
///
/// A manual counterparty is NEVER a fake `Company` row. Inventing one would give
/// it a Store Account ID, a tenant scope and a login path, none of which it
/// should have.
model Counterparty {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)

  kind CounterpartyKind

  connectedCompanyId Bytes? @map("connected_company_id") @db.Binary(16)
  connectionId       Bytes? @map("connection_id") @db.Binary(16)
  userId             Bytes? @map("user_id") @db.Binary(16)

  /// Also the display name for a connected store, so a rename on their side
  /// cannot silently retitle our historical records.
  name  String  @db.VarChar(160)
  phone String? @db.VarChar(40)
  city  String? @db.VarChar(120)
  note  String? @db.VarChar(255)

  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(0)
  createdById Bytes?   @map("created_by_id") @db.Binary(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company          Company          @relation(fields: [companyId], references: [id])
  connectedCompany Company?         @relation("CounterpartyConnectedCompany", fields: [connectedCompanyId], references: [id])
  connection       StoreConnection? @relation(fields: [connectionId], references: [id])
  user             User?            @relation("CounterpartyUser", fields: [userId], references: [id])
  createdBy        User?            @relation("CounterpartyCreatedBy", fields: [createdById], references: [id])

  consignments Consignment[]

  @@index([companyId, kind, isActive])
  @@index([connectionId])
  @@index([userId])
  @@index([createdById])
  @@map("counterparties")
}

/// Detailed internal states. The UI groups them into Pending / Accepted /
/// Confirmed, but the record keeps the distinctions — "accepted" and "the phone
/// is physically there" are different facts, and collapsing them is how a shop
/// ends up believing stock moved when it did not.
enum ConsignmentStatus {
  draft
  requested
  counter_proposed
  disputed
  accepted_awaiting_custody
  custody_awaiting_confirmation
  in_custody
  sold_awaiting_settlement
  partially_paid
  return_initiated
  return_in_transit
  settled
  returned_accepted
  forgiven_settled
  cancelled
}

/// **The first table in this schema that belongs to two companies at once.**
///
/// It therefore CANNOT be scoped automatically by `tenant.extension.ts`, and the
/// guard that protects every other table stops protecting this one. Every read
/// must go through `consignment-scope.ts`, which filters
/// `sourceCompanyId = me OR destinationCompanyId = me`, and a spec asserts no
/// query bypasses it.
model Consignment {
  id Bytes @id @db.Binary(16)

  /// Always set: the company that owns the stock and carries the receivable.
  sourceCompanyId Bytes @map("source_company_id") @db.Binary(16)
  sourceBranchId  Bytes @map("source_branch_id") @db.Binary(16)

  /// Set for an application counterparty, null for a manual one. This column is
  /// what makes the record cross-tenant.
  destinationCompanyId Bytes? @map("destination_company_id") @db.Binary(16)
  /// The source's own view of who this went to, always set.
  counterpartyId Bytes  @map("counterparty_id") @db.Binary(16)
  connectionId   Bytes? @map("connection_id") @db.Binary(16)

  status ConsignmentStatus @default(draft)

  proposedAmount Decimal? @map("proposed_amount") @db.Decimal(14, 2)
  counterAmount  Decimal? @map("counter_amount") @db.Decimal(14, 2)
  /// Immutable once custody is confirmed — after that the phone is in another
  /// shop and the price cannot move under them.
  agreedAmount   Decimal? @map("agreed_amount") @db.Decimal(14, 2)

  /// A dispute must say why. "Rejected" with no reason is not a conversation.
  disputeReason String? @map("dispute_reason") @db.VarChar(255)
  note          String? @db.VarChar(255)

  proposedById         Bytes?    @map("proposed_by_id") @db.Binary(16)
  decidedById          Bytes?    @map("decided_by_id") @db.Binary(16)
  decidedAt            DateTime? @map("decided_at") @db.DateTime(6)
  custodySentAt        DateTime? @map("custody_sent_at") @db.DateTime(6)
  custodySentById      Bytes?    @map("custody_sent_by_id") @db.Binary(16)
  custodyConfirmedAt   DateTime? @map("custody_confirmed_at") @db.DateTime(6)
  custodyConfirmedById Bytes?    @map("custody_confirmed_by_id") @db.Binary(16)
  settledAt            DateTime? @map("settled_at") @db.DateTime(6)

  clientUuid Bytes?   @map("client_uuid") @db.Binary(16)
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  sourceCompany      Company          @relation("ConsignmentSource", fields: [sourceCompanyId], references: [id])
  sourceBranch       Branch           @relation(fields: [sourceBranchId], references: [id])
  destinationCompany Company?         @relation("ConsignmentDestination", fields: [destinationCompanyId], references: [id])
  counterparty       Counterparty     @relation(fields: [counterpartyId], references: [id])
  connection         StoreConnection? @relation(fields: [connectionId], references: [id])

  lines  ConsignmentLine[]
  ledger ConsignmentLedgerEntry[]

  @@unique([sourceCompanyId, clientUuid], map: "ux_consignments_client_uuid")
  @@index([sourceCompanyId, status, createdAt], map: "ix_consignments_source")
  @@index([destinationCompanyId, status, createdAt], map: "ix_consignments_destination")
  @@index([counterpartyId])
  @@index([sourceBranchId])
  @@index([connectionId])
  @@map("consignments")
}

enum ConsignmentLineStatus {
  proposed
  in_custody
  sold
  returned
  cancelled
}

/// How a line ended. Recorded on the LINE rather than inferred from the parent,
/// because a multi-line consignment can have some sold and some returned.
enum ConsignmentDisposition {
  sold
  returned
  damaged
  forgiven
}

enum ConsignmentReturnCondition {
  good
  damaged
}

/// One phone per line.
///
/// There is deliberately no destination unit. Store 2 has custody, not
/// ownership, and a second owned row could be sold independently — the
/// double-sale this whole design exists to make impossible.
model ConsignmentLine {
  id            Bytes @id @db.Binary(16)
  consignmentId Bytes @map("consignment_id") @db.Binary(16)
  /// Denormalised so a line can be scoped without joining its parent.
  sourceCompanyId Bytes @map("source_company_id") @db.Binary(16)

  unitId Bytes @map("unit_id") @db.Binary(16)

  /// Snapshotted at proposal, because this is what the destination was shown and
  /// agreed to. **Cost and margin are absent by design.**
  brand         String? @db.VarChar(80)
  model         String  @db.VarChar(120)
  variant       String? @db.VarChar(120)
  identifier    String  @db.VarChar(64)
  conditionNote String? @map("condition_note") @db.VarChar(255)
  /// Defects the source chose to disclose, so "I was not told" is answerable.
  defectNote    String? @map("defect_note") @db.VarChar(255)

  agreedAmount Decimal? @map("agreed_amount") @db.Decimal(14, 2)

  status          ConsignmentLineStatus       @default(proposed)
  disposedAt      DateTime?                   @map("disposed_at") @db.DateTime(6)
  disposition     ConsignmentDisposition?
  returnCondition ConsignmentReturnCondition? @map("return_condition")
  returnNote      String?                     @map("return_note") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  consignment   Consignment @relation(fields: [consignmentId], references: [id])
  unit          Unit        @relation(fields: [unitId], references: [id])
  sourceCompany Company     @relation(fields: [sourceCompanyId], references: [id])

  ledger ConsignmentLedgerEntry[]

  // Uniqueness is on the generated `active_unit_id` (0049): a unit can be on
  // only ONE active consignment. That is the database half of the double-claim
  // guarantee; the compare-and-swap on `units.status` is the other half.
  @@index([consignmentId, status])
  @@index([unitId])
  @@index([sourceCompanyId])
  @@map("consignment_lines")
}

/// What each ledger row means. A payment REPORT changes nothing until it is
/// confirmed — the same two-party rule refunds and supplier settlements follow.
enum ConsignmentLedgerKind {
  receivable_raised
  payment_reported
  payment_confirmed
  payment_corrected
  forgiven
  settled
}

/// The money, append-only. What is owed is DERIVED from these rows and stored
/// nowhere, the same rule the employee debt ledger follows.
model ConsignmentLedgerEntry {
  id            Bytes @id @db.Binary(16)
  consignmentId Bytes @map("consignment_id") @db.Binary(16)
  /// Both sides, so either company can read its own ledger without a join.
  sourceCompanyId      Bytes  @map("source_company_id") @db.Binary(16)
  destinationCompanyId Bytes? @map("destination_company_id") @db.Binary(16)

  kind ConsignmentLedgerKind
  /// Always a positive magnitude; `kind` carries the direction.
  amount Decimal @db.Decimal(14, 2)

  lineId Bytes? @map("line_id") @db.Binary(16)

  method               RefundMethod?
  receivingAccountId   Bytes?  @map("receiving_account_id") @db.Binary(16)
  /// Frozen: renaming an account later must not retitle a movement.
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)
  reference            String? @db.VarChar(120)
  evidenceRef          String? @map("evidence_ref") @db.VarChar(512)

  /// Mandatory for forgiveness and correction.
  reason String? @db.VarChar(255)

  /// Which side wrote this, so a two-party flow can tell report from confirm.
  actingCompanyId Bytes    @map("acting_company_id") @db.Binary(16)
  actingUserId    Bytes?   @map("acting_user_id") @db.Binary(16)
  entryDate       DateTime @map("entry_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)
  clientUuid      Bytes?   @map("client_uuid") @db.Binary(16)
  /// The reported entry a confirmation or correction refers to.
  refersToId      Bytes?   @map("refers_to_id") @db.Binary(16)

  consignment        Consignment       @relation(fields: [consignmentId], references: [id])
  sourceCompany      Company           @relation("LedgerSource", fields: [sourceCompanyId], references: [id])
  destinationCompany Company?          @relation("LedgerDestination", fields: [destinationCompanyId], references: [id])
  actingCompany      Company           @relation("LedgerActing", fields: [actingCompanyId], references: [id])
  line               ConsignmentLine?  @relation(fields: [lineId], references: [id])
  receivingAccount   ReceivingAccount? @relation(fields: [receivingAccountId], references: [id])
  actingUser         User?             @relation(fields: [actingUserId], references: [id])
  refersTo           ConsignmentLedgerEntry?  @relation("LedgerRefers", fields: [refersToId], references: [id])
  referredBy         ConsignmentLedgerEntry[] @relation("LedgerRefers")

  @@unique([actingCompanyId, clientUuid], map: "ux_cledger_client_uuid")
  @@index([consignmentId, kind])
  @@index([sourceCompanyId, entryDate], map: "ix_cledger_source")
  @@index([destinationCompanyId, entryDate], map: "ix_cledger_destination")
  @@index([lineId])
  @@index([receivingAccountId])
  @@index([actingUserId])
  @@index([refersToId])
  @@map("consignment_ledger")
}
