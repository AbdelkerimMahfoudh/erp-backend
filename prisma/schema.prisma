// ===========================================================================
// Phone Store Management ERP — Prisma schema (MySQL 8 / InnoDB)
// Design: docs/10_DATABASE_SCHEMA.md · Architecture: docs/06_TECHNICAL_ARCHITECTURE.md
//
// Conventions (MySQL 8.0+):
//   * PRIMARY KEYS = UUIDv7 stored as BINARY(16) (Prisma `Bytes @db.Binary(16)`),
//     generated APP-SIDE (offline-friendly). See prisma/lib/uuid.ts for the
//     string <-> binary conversion helpers. No DB default — the app/seed supply
//     the id on every create (a create middleware does this in the API phase).
//   * Money = Decimal(14,2) (never float). Timestamps = DateTime(6), UTC.
//   * company_id on EVERY table incl. line tables — tenant isolation is
//     ENFORCED IN THE BACKEND (app-layer), because MySQL has no RLS.
//   * Enums map to native MySQL ENUM columns.
//
// NOT modelled here — implemented in migration 0002_mysql_extras:
//   generated columns (sold-once `active_unit_id`, settings `branch_scope`) +
//   their UNIQUE indexes, FULLTEXT product search, CHECK constraints,
//   app-user GRANTs + audit-log append-only REVOKE.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ------------------------------- Enums -------------------------------------

enum RoleKey {
  owner

  /// Store-facing roles (0016). Owner + these three are the only roles shown
  /// in store onboarding.
  store_manager
  store_employee

  /// Internal SaaS role — never offered in store-facing onboarding.
  administrator

  /// Legacy, retained until no assignment references them. Retiring them is a
  /// separate migration; see docs/21.
  branch_manager
  sales_employee
  warehouse_employee
}

enum BranchType {
  store
  warehouse
}

/// Language for Owner WhatsApp summaries. Separate from the app's UI language,
/// which is a device preference — the Owner may read the app in one language
/// and want the nightly message in another.
enum SummaryLanguage {
  en
  ar
}

/// Money-receiving providers used in Mauritania, plus an escape hatch.
/// `other` carries its name in `ReceivingAccount.providerName` rather than
/// forcing a schema change every time a shop uses a new service.
enum ReceivingProvider {
  bankily
  sedad
  bim_bank
  other
}

enum TrackingType {
  imei
  serial
  quantity
}

enum RecognitionStatus {
  proposed
  confirmed
  superseded
}

enum CodeType {
  tac
  barcode
  serial_prefix
}

enum UnitStatus {
  in_stock
  reserved
  sold
  returned
  faulty
  in_transit
  /// Moved to another BRANCH of this company. Internal.
  transferred_out
  /// Held by another COMPANY on consignment (0049). Ownership has not moved:
  /// the phone is still ours, which is exactly why it needs its own state
  /// rather than reusing `transferred_out`.
  consigned_out
}

enum PurchaseStatus {
  paid
  partial
  unpaid
}

enum SalePayStatus {
  paid
  partial
  credit
}

enum PaymentMethod {
  cash
  card
  mobile
  bank
  other
}

enum TransferStatus {
  /// An employee has asked; stock is already reserved but nobody has agreed yet.
  pending_approval
  /// Agreed and ready to leave. Replaces the old `ready_to_ship`, which meant
  /// exactly this but without anyone having approved it.
  approved
  in_transit
  received
  /// Refused by an approver, with a reason. Terminal; reservations released.
  rejected
  cancelled
}

enum ExpenseStatus {
  reported
  confirmed
  rejected
}

enum ExpenseClass {
  variable
  fixed
}

enum ExpenseRecurrence {
  none
  monthly
  yearly
}

enum ImportStatus {
  parsing
  preview
  committed
  failed
}

/// What a sheet describes, from its identifier column (0048).
enum ImportKind {
  imei
  serial
  quantity
}

/// Which table an import row's product ended up in.
enum ImportCreatedKind {
  unit
  stock_item
}

enum ImportRowStatus {
  valid
  warning
  error
}

enum AuditAction {
  create
  update
  delete
  status_change
  override
  login
  logout
}

enum SyncStatus {
  pending
  accepted
  conflict
  rejected
}

// ------------------------- Tenancy & Access --------------------------------

model Company {
  id           Bytes    @id @db.Binary(16)
  name         String   @db.VarChar(160)
  /// Public Store Account ID (F1 Stage 3.2): the human-typable, NON-secret code
  /// that selects this company before login. Canonical = 10 uppercase hex chars.
  /// Not the binary `id`, a branch id, a device id or a subscription id.
  /// Generated on create, unique, immutable through store-facing APIs.
  publicStoreId String  @unique @map("public_store_id") @db.VarChar(16)
  /// Discovery (0049). Off until the Owner turns it on: a shop that never
  /// heard of consignment must not be searchable by every other shop by
  /// default. Publication is a decision, not a default.
  isDiscoverable Boolean @default(false) @map("is_discoverable")
  /// Coarse location only. Never an address — a city narrows a search, an
  /// address identifies a building full of stock.
  city           String? @db.VarChar(120)
  logoRef        String? @map("logo_ref") @db.VarChar(512)
  /// Shown only AFTER a connection is accepted, so a connection request cannot
  /// be used to harvest phone numbers.
  publicPhone    String? @map("public_phone") @db.VarChar(40)

  currency     String   @default("USD") @db.Char(3)
  timezone     String   @default("UTC") @db.VarChar(64)
  settingsJson Json     @map("settings") @db.Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  branches          Branch[]
  users             User[]
  roles             Role[]
  rolePermissions   RolePermission[]
  userBranches      UserBranch[]
  products          Product[]
  units             Unit[]
  stockItems        StockItem[]
  suppliers         Supplier[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  supplierPayments  SupplierPayment[]
  customers         Customer[]
  sales             Sale[]
  saleItems         SaleItem[]
  payments          Payment[]
  returns           Return[]
  refundPayouts     RefundPayout[]
  financialCorrections FinancialCorrection[]
    returnRequests    ReturnRequest[]
  returnAdjustments ReturnAdjustment[]
  returnReversals   ReturnReversal[]
    stockTransfers    StockTransfer[]
  transferItems     TransferItem[]
  expenseTemplates  ExpenseTemplate[]
  expenses          Expense[]
  dailyClosings     DailyClosing[]
  goals             Goal[]
  connectionsRequested StoreConnection[] @relation("ConnectionRequester")
  connectionsReceived  StoreConnection[] @relation("ConnectionAddressee")
  connectionsBlocked   StoreConnection[] @relation("ConnectionBlockedBy")
  counterparties       Counterparty[]
  counterpartyOf       Counterparty[]    @relation("CounterpartyConnectedCompany")
  consignmentsOut      Consignment[]     @relation("ConsignmentSource")
  consignmentsIn       Consignment[]     @relation("ConsignmentDestination")
  consignmentLines     ConsignmentLine[]
  consignmentLedgerAsSource      ConsignmentLedgerEntry[] @relation("LedgerSource")
  consignmentLedgerAsDestination ConsignmentLedgerEntry[] @relation("LedgerDestination")
  consignmentLedgerActed         ConsignmentLedgerEntry[] @relation("LedgerActing")
  closingChannelCounts ClosingChannelCount[]
  closingDiscrepancies ClosingDiscrepancy[]
  employeeDebtEntries  EmployeeDebtEntry[]
  dailyDigests      DailyDigest[]
  digestLines       DigestLine[]
  notifications     Notification[]
  importBatches     ImportBatch[]
  importRows        ImportRow[]
  reportDefinitions ReportDefinition[]
  reportSnapshots   ReportSnapshot[]
  auditLogs         AuditLog[]
  settings          Setting[]
  companySettings   CompanySettings?
  receivingAccounts ReceivingAccount[]
  syncDevices        SyncDevice[]
  outboxChanges      OutboxChange[]
  authSessions       AuthSession[]
  userDevices        UserDevice[]
  otpChallenges       OtpChallenge[]
  verificationIntents VerificationIntent[]
  userBranchPermissions UserBranchPermission[]
  branchVariantPrices   BranchVariantPrice[]
  unitPriceOverrides    UnitPriceOverride[]
  priceChangeEvents     PriceChangeEvent[]
  branchCounters     BranchCounter[]
  productCategories  ProductCategory[]
  productRecognitions ProductRecognition[]
  recognitionOutbox RecognitionOutbox[]

  @@map("companies")
  supplierSettlements SupplierSettlement[]
  supplierSettlementAllocations SupplierSettlementAllocation[]
}

model Branch {
  id        Bytes      @id @db.Binary(16)
  companyId Bytes      @map("company_id") @db.Binary(16)
  name      String     @db.VarChar(160)
  type      BranchType @default(store)
  address   String?    @db.VarChar(255)
  phone     String?    @db.VarChar(40)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt DateTime?  @map("deleted_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])

  refundPayouts    RefundPayout[]
  financialCorrections FinancialCorrection[]
    returnRequests   ReturnRequest[]
  returnReversals  ReturnReversal[]
    userBranches     UserBranch[]
  units            Unit[]
  stockItems       StockItem[]
  purchases        Purchase[]
  sales            Sale[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  expenseTemplates ExpenseTemplate[]
  expenses         Expense[]
  dailyClosings    DailyClosing[]
  goals            Goal[]
  consignments     Consignment[]
  closingDiscrepancies ClosingDiscrepancy[]
  employeeDebtEntries  EmployeeDebtEntry[]
  dailyDigests     DailyDigest[]
  notifications    Notification[]
  importBatches    ImportBatch[]
  settings         Setting[]
  branchCounters   BranchCounter[]
  branchVariantPrices BranchVariantPrice[]
  unitPriceOverrides  UnitPriceOverride[]
  priceChangeEvents   PriceChangeEvent[]

  @@unique([companyId, name]) // company_id is the leftmost column → covers company scans
  @@map("branches")
  supplierSettlements SupplierSettlement[]
}

model User {
  expensesReported  Expense[] @relation("ExpenseReportedBy")
  expensesConfirmed Expense[] @relation("ExpenseConfirmedBy")

  /// TAC mappings this user proposed, and those they confirmed. Two relations,
  /// because who suggested and who decided must stay distinguishable.
  recognitionsProposed  ProductRecognition[] @relation("RecognitionProposedBy")
  recognitionsConfirmed ProductRecognition[] @relation("RecognitionConfirmedBy")

  /// Corrections this user asked for, and corrections they decided. Two
  /// relations rather than one, because who requested and who approved must
  /// stay distinguishable even when an owner does both.
  correctionsRequested FinancialCorrection[] @relation("CorrectionRequestedBy")
  correctionsDecided   FinancialCorrection[] @relation("CorrectionDecidedBy")

  /// Closings this user COUNTED, kept apart from `closedBy` on `DailyClosing`.
  /// Separating the two is the point of `closing.count` — an Employee counts
  /// the drawer, somebody senior signs the day off, and the record says which
  /// of them did what.
  closingsCounted DailyClosing[]        @relation("ClosingCountedBy")
  channelCounts   ClosingChannelCount[] @relation("ChannelCountedBy")

  /// Discrepancies this user was held responsible for, and discrepancies they
  /// resolved. Never the same relation: the Owner deciding and the person
  /// carrying the shortage must stay distinguishable.
  discrepanciesResponsible ClosingDiscrepancy[] @relation("DiscrepancyResponsible")
  discrepanciesResolved    ClosingDiscrepancy[] @relation("DiscrepancyResolvedBy")

  /// Ledger rows ABOUT this user, and ledger rows this user wrote.
  debtEntries        EmployeeDebtEntry[] @relation("DebtSubject")
  debtEntriesCreated EmployeeDebtEntry[] @relation("DebtCreatedBy")

  /// Goals set FOR this person, and goals this person set. Two relations,
  /// because who is aiming and who decided the aim must stay distinguishable.
  goalsTargeted Goal[]             @relation("GoalTargetUser")
  goalsCreated  Goal[]             @relation("GoalCreatedBy")

  /// Imports this user COMMITTED, kept apart from the one who uploaded.
  importsCommitted ImportBatch[] @relation("ImportCommittedBy")

  /// Consignment and connection roles. Named because several of them touch the
  /// same model and Prisma cannot tell them apart otherwise.
  connectionsRequestedBy StoreConnection[] @relation("ConnectionRequestedBy")
  connectionsDecidedBy   StoreConnection[] @relation("ConnectionDecidedBy")
  counterpartyRecords    Counterparty[]    @relation("CounterpartyUser")
  counterpartiesCreated  Counterparty[]    @relation("CounterpartyCreatedBy")
  consignmentLedgerEntries ConsignmentLedgerEntry[]

  id           Bytes     @id @db.Binary(16)
  companyId    Bytes     @map("company_id") @db.Binary(16)
  name         String    @db.VarChar(160)
  login        String    @db.VarChar(120)
  /// Contact phone in E.164 (e.g. +2223xxxxxxx). The future WhatsApp OTP and
  /// recovery channel, so uniqueness is enforced in the database — see
  /// @@unique([companyId, phone]) — not in application code, where two devices
  /// could race onto one number. Null until captured; existing users stay null.
  phone           String?   @db.VarChar(24)
  /// Set only by a real verification event, and cleared whenever `phone`
  /// changes. Never set it to fake "verified" — there is no verification
  /// mechanism in Stage 1, so this stays null until Stage 4 delivers OTP.
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.DateTime(6)
  /// Optional recovery address. Not unique in Stage 1 (docs/23 §4 enforces
  /// uniqueness only on `phone`); email uniqueness is deferred.
  email           String?   @db.VarChar(160)
  /// Set only by a real verification event, and cleared whenever `email` changes.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(6)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  pinHash      String?   @map("pin_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])

  userBranches      UserBranch[]
  grantsMade        UserBranchPermission[] @relation("GrantsMade")
  branchPricesSet   BranchVariantPrice[]   @relation("BranchPriceSetBy")
  unitPricesSet     UnitPriceOverride[]    @relation("UnitPriceSetBy")
  priceChanges      PriceChangeEvent[]     @relation("PriceChangeActor")
  unitsCreated      Unit[]             @relation("UnitCreatedBy")
  unitsUpdated      Unit[]             @relation("UnitUpdatedBy")
  purchases         Purchase[]
  supplierPayments  SupplierPayment[]
  sales             Sale[]
  returnsRequested      ReturnRequest[]    @relation("ReturnRequestedBy")
  returnsReviewed       ReturnRequest[]    @relation("ReturnReviewedBy")
  returnsDecided        ReturnRequest[]    @relation("ReturnDecidedBy")
  returnsApproved       ReturnReversal[]   @relation("ReturnApprovedBy")
  refundsReported       RefundPayout[]     @relation("RefundReportedBy")
  refundsConfirmed      RefundPayout[]     @relation("RefundConfirmedBy")
  returnAdjustmentsMade ReturnAdjustment[] @relation("ReturnAdjustmentBy")
    returnPolicyOverrides Sale[] @relation("SaleReturnPolicyOverride")
  returns           Return[]
  transfersSent     StockTransfer[]    @relation("TransferSentBy")
  transfersReceived StockTransfer[]    @relation("TransferReceivedBy")
  transfersRequested StockTransfer[]   @relation("TransferRequestedBy")
  transfersApproved StockTransfer[]    @relation("TransferApprovedBy")
  transfersDecided  StockTransfer[]    @relation("TransferDecidedBy")
  expenses          Expense[]
  dailyClosings     DailyClosing[]
  digestLines       DigestLine[]
  notifications     Notification[]
  importBatches     ImportBatch[]
  reportDefinitions ReportDefinition[]
  auditLogs         AuditLog[]
  syncDevices       SyncDevice[]
  authSessions      AuthSession[]
  userDevices       UserDevice[]
  otpChallenges       OtpChallenge[]
  verificationIntents VerificationIntent[]

  @@unique([companyId, login]) // company_id leftmost → covers company scans
  @@unique([companyId, phone]) // one phone per company; NULLs coexist (recovery/OTP channel)
  @@map("users")
  settlementsReported  SupplierSettlement[] @relation("SettlementReportedBy")
  settlementsConfirmed SupplierSettlement[] @relation("SettlementConfirmedBy")
}

model Role {
  id        Bytes   @id @db.Binary(16)
  companyId Bytes   @map("company_id") @db.Binary(16)
  key       RoleKey
  name      String  @db.VarChar(80)

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userBranches    UserBranch[]

  @@unique([companyId, key]) // company_id leftmost → covers company scans
  @@map("roles")
}

model Permission {
  id    Bytes  @id @db.Binary(16)
  key   String @unique @db.VarChar(80)
  label String @db.VarChar(160)

  rolePermissions RolePermission[]
  userBranchPermissions UserBranchPermission[]

  @@map("permissions")
}

model RolePermission {
  companyId    Bytes @map("company_id") @db.Binary(16)
  roleId       Bytes @map("role_id") @db.Binary(16)
  permissionId Bytes @map("permission_id") @db.Binary(16)

  company    Company    @relation(fields: [companyId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([companyId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranch {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)
  branchId  Bytes @map("branch_id") @db.Binary(16)
  roleId    Bytes @map("role_id") @db.Binary(16)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  permissions UserBranchPermission[]

  @@unique([userId, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([roleId])
  @@map("user_branches")
}

/// Per-branch delegated permission grant (F1 Stage 2). An Owner delegates a
/// narrow, allow-listed permission (e.g. `price.edit`) to ONE assignment — a
/// specific user in a specific branch. It is additive only (no deny), scoped to
/// the `UserBranch` row (so removing the assignment cascades the grant away),
/// and can never be company-global. Uniqueness is one grant per (assignment,
/// permission). The delegatable allow-list and the branch-scoped resolution are
/// enforced in code (see rbac/permission-scope.ts, access.service).
model UserBranchPermission {
  companyId    Bytes    @map("company_id") @db.Binary(16)
  userBranchId Bytes    @map("user_branch_id") @db.Binary(16)
  permissionId Bytes    @map("permission_id") @db.Binary(16)
  grantedById  Bytes    @map("granted_by_id") @db.Binary(16)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.DateTime(6)

  company    Company    @relation(fields: [companyId], references: [id])
  userBranch UserBranch @relation(fields: [userBranchId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("GrantsMade", fields: [grantedById], references: [id])

  @@id([userBranchId, permissionId])
  @@index([companyId])
  @@index([permissionId])
  @@map("user_branch_permissions")
}

// ------------------------- Catalog & Inventory -----------------------------

model Product {
  id               Bytes        @id @db.Binary(16)
  companyId        Bytes        @map("company_id") @db.Binary(16)
  categoryId       Bytes?       @map("category_id") @db.Binary(16)
  brand            String       @db.VarChar(80)
  model            String       @db.VarChar(120)
  variant          String?      @db.VarChar(120)
  trackingType     TrackingType @default(imei) @map("tracking_type")
  specifications   Json?        @db.Json // adaptive, category-defined attribute values
  barcode          String?      @db.VarChar(64)
  defaultCost      Decimal?     @map("default_cost") @db.Decimal(14, 2)
  defaultPrice     Decimal?     @map("default_price") @db.Decimal(14, 2)
  reorderThreshold Int          @default(0) @map("reorder_threshold")
  taxRate          Decimal?     @map("tax_rate") @db.Decimal(6, 4) // reserved v2
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt        DateTime?    @map("deleted_at") @db.DateTime(6)

  company       Company              @relation(fields: [companyId], references: [id])
  category      ProductCategory?     @relation(fields: [categoryId], references: [id])
  units         Unit[]
  stockItems    StockItem[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
    transferItems TransferItem[]
  recognitions  ProductRecognition[]
  branchPrices  BranchVariantPrice[]
  priceEvents   PriceChangeEvent[]

  @@unique([companyId, brand, model, variant]) // company_id leftmost → covers company scans
  @@unique([companyId, barcode])
  @@index([categoryId])
  @@map("products")
}

// Category taxonomy with a default tracking type + adaptive attribute schema.
model ProductCategory {
  id                  Bytes        @id @db.Binary(16)
  companyId           Bytes        @map("company_id") @db.Binary(16)
  name                String       @db.VarChar(80)
  defaultTrackingType TrackingType @map("default_tracking_type")
  attributeSchema     Json?        @map("attribute_schema") @db.Json
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.DateTime(6)

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

// Learning map: a scanned code (TAC / barcode / future serial_prefix) → product.
model ProductRecognition {
  id              Bytes     @id @db.Binary(16)
  companyId       Bytes     @map("company_id") @db.Binary(16)
  codeType        CodeType  @map("code_type")
  code            String    @db.VarChar(64)
  productId       Bytes     @map("product_id") @db.Binary(16)
  timesSeen       Int       @default(1) @map("times_seen")
  confirmations   Int       @default(0)
  corrections     Int       @default(0)
  lastSeenAt      DateTime? @map("last_seen_at") @db.DateTime(6)
  lastConfirmedAt DateTime? @map("last_confirmed_at") @db.DateTime(6)
  lastCorrectedAt DateTime? @map("last_corrected_at") @db.DateTime(6)
  sourceStats     Json?     @map("source_stats") @db.Json // {receiving,scan,sale,manual} counts
  /// The authority distinction (Milestone C). `proposed` is an Employee's
  /// suggestion and is NEVER authoritative; `confirmed` is an Owner's or
  /// Manager's decision; `superseded` is a replaced mapping, kept rather than
  /// deleted so what a shop once believed about a code survives.
  status          RecognitionStatus @default(confirmed)
  proposedById    Bytes?    @map("proposed_by_id") @db.Binary(16)
  confirmedById   Bytes?    @map("confirmed_by_id") @db.Binary(16)
  confirmedAt     DateTime? @map("confirmed_at") @db.DateTime(6)
  /// Where the evidence came from: receiving, scan, sale, manual.
  evidenceSource  String?   @map("evidence_source") @db.VarChar(24)
  /// Optimistic concurrency: two managers confirming one TAC, one winner.
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  proposedBy  User? @relation("RecognitionProposedBy", fields: [proposedById], references: [id])
  confirmedBy User? @relation("RecognitionConfirmedBy", fields: [confirmedById], references: [id])

  @@index([companyId, codeType, code, status])
  @@index([companyId, productId])
  @@index([productId])
  @@map("product_recognition")
}

model TacCatalog {
  tac            String  @id @db.Char(8)
  brand          String? @db.VarChar(80)
  model          String? @db.VarChar(120)
  defaultVariant String? @map("default_variant") @db.VarChar(120)

  @@map("tac_catalog")
}

model Unit {
  /// Consignment lines this unit has been on. Ownership never leaves this
  /// company — a consigned phone is in somebody else's shop, not their books.
  consignmentLines ConsignmentLine[]

  id            Bytes      @id @db.Binary(16)
  companyId     Bytes      @map("company_id") @db.Binary(16)
  productId     Bytes      @map("product_id") @db.Binary(16)
  branchId      Bytes      @map("branch_id") @db.Binary(16)
  supplierId    Bytes?     @map("supplier_id") @db.Binary(16)
  purchaseId    Bytes?     @map("purchase_id") @db.Binary(16)
  imeiPrimary   String?    @map("imei_primary") @db.VarChar(15)
  imeiSecondary String?    @map("imei_secondary") @db.VarChar(15)
  serialNo      String?    @map("serial_no") @db.VarChar(60)
  // NOTE: a generated STORED `identifier` = COALESCE(imei_primary, serial_no)
  // with a UNIQUE index exists in the DB (migration 0008) — not modelled here
  // (Prisma can't express generated columns; appears as an expected diff extra).
  cost          Decimal    @db.Decimal(14, 2) // exact per-unit cost (D4)
  status        UnitStatus @default(in_stock)
  dateIn        DateTime   @default(now()) @map("date_in") @db.DateTime(6)
  dateSold      DateTime?  @map("date_sold") @db.DateTime(6)
  imageRef      String?    @map("image_ref") @db.VarChar(512)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(6)
  createdById   Bytes?     @map("created_by") @db.Binary(16)
  updatedById   Bytes?     @map("updated_by") @db.Binary(16)

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  purchase  Purchase? @relation(fields: [purchaseId], references: [id])
  createdBy User?     @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("UnitUpdatedBy", fields: [updatedById], references: [id])

  saleItems     SaleItem[]
  returns       Return[]
  returnRequests  ReturnRequest[]
  returnReversals ReturnReversal[]
  transferItems TransferItem[]
  priceOverride UnitPriceOverride?
  priceEvents   PriceChangeEvent[]

  @@unique([imeiSecondary]) // MySQL allows multiple NULLs → unique-when-present
  @@index([companyId, branchId, status])
  @@index([productId])
  @@index([supplierId])
  @@index([purchaseId])
  @@map("units")
}

/// The selling price of ONE exact product variant in ONE branch (G2A).
///
/// This is the middle rung of the serialized price ladder:
/// `UnitPriceOverride` → `BranchVariantPrice` → `Product.defaultPrice` → unpriced.
/// It exists because `Product.defaultPrice` is company-wide, so a Manager with
/// branch-scoped `price.edit` must never change a price by mutating it.
///
/// **Serialized products only.** Quantity-tracked stock keeps `StockItem.price`
/// as its authoritative branch price — G2A deliberately adds no second source
/// for it. Absence of a row here means "fall back", so nothing is backfilled.
model BranchVariantPrice {
  id        Bytes    @id @db.Binary(16)
  companyId Bytes    @map("company_id") @db.Binary(16)
  branchId  Bytes    @map("branch_id") @db.Binary(16)
  productId Bytes    @map("product_id") @db.Binary(16)
  /// Same precision as every other monetary column. Never a formatted string.
  price     Decimal  @db.Decimal(14, 2)
  /// Compare-and-swap guard: a stale edit is a 409, never a silent overwrite.
  version   Int      @default(0)
  setById   Bytes?   @map("set_by") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  setBy   User?   @relation("BranchPriceSetBy", fields: [setById], references: [id])

  @@unique([productId, branchId]) // exactly one current price per variant per branch
  @@index([companyId])
  @@index([branchId])
  @@map("branch_variant_prices")
}

/// A price override for ONE exact serialized unit (G2A) — the top rung.
///
/// **`branchId` is the branch under whose authority the override was created**,
/// and it is deliberately NOT redundant with the unit's current branch. A
/// Manager holds `price.edit` per branch, so an override they set in Branch A
/// must not follow the phone into Branch B and quietly take effect there.
///
/// CP3 therefore resolves an override as effective **only while
/// `UnitPriceOverride.branchId == Unit.branchId`**, and a transfer must retire
/// the row inside the transfer transaction (recording a `PriceChangeEvent`), so
/// returning the unit later cannot silently reactivate an obsolete price.
///
/// A quantity-tracked product cannot acquire one: the row requires a real
/// `Unit`, and quantity stock has none.
model UnitPriceOverride {
  id        Bytes    @id @db.Binary(16)
  companyId Bytes    @map("company_id") @db.Binary(16)
  /// The branch whose authority set this price — NOT necessarily where the unit is now.
  branchId  Bytes    @map("branch_id") @db.Binary(16)
  unitId    Bytes    @map("unit_id") @db.Binary(16)
  price     Decimal  @db.Decimal(14, 2)
  version   Int      @default(0)
  setById   Bytes?   @map("set_by") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  setBy   User?   @relation("UnitPriceSetBy", fields: [setById], references: [id])

  @@unique([unitId]) // at most ONE authoritative current override per unit
  @@index([companyId])
  @@index([branchId])
  @@map("unit_price_overrides")
}

/// Append-only history of every price change (G2A). Immutable financial record,
/// not current state — `branch_variant_prices` and `unit_price_overrides` hold
/// the current values.
///
/// Removing an override is recorded as an event with `newPrice = NULL`, never by
/// deleting a row; a future transfer invalidation is the same shape with
/// `initiator = 'system'`. UPDATE and DELETE are blocked by database triggers
/// for the application account, following the `audit_logs` pattern.
model PriceChangeEvent {
  id        Bytes  @id @db.Binary(16)
  companyId Bytes  @map("company_id") @db.Binary(16)
  branchId  Bytes  @map("branch_id") @db.Binary(16)
  productId Bytes  @map("product_id") @db.Binary(16)
  /// Set for a unit-scoped change; null for a branch-variant change.
  unitId    Bytes? @map("unit_id") @db.Binary(16)
  /// `unit` | `branch_variant` | `stock_item` — which rung of the ladder changed.
  /// `stock_item` covers a quantity product's branch price, which lives on
  /// `stock_items.price` rather than in a pricing table (CP3).
  scope     String @db.VarChar(20)
  /// `user` | `system` — a person, or an automatic change such as a transfer
  /// retiring an override.
  ///
  /// CP2 sketched this as `owner` | `manager` | `system`. CP3 does not record a
  /// role: `actorId` already says exactly who acted, a role can change
  /// afterwards while history must not, and copying a role into every row would
  /// be a second source of truth that drifts from the first.
  initiator String @db.VarChar(20)
  /// Null when the price is being set for the first time.
  previousPrice Decimal? @map("previous_price") @db.Decimal(14, 2)
  /// Null when the price is being removed and the row reverts to a fallback.
  newPrice      Decimal? @map("new_price") @db.Decimal(14, 2)
  /// Required by the service for a below-cost Owner change; free text otherwise.
  reason    String?  @db.Text
  actorId   Bytes?   @map("actor_id") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  company Company  @relation(fields: [companyId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  unit    Unit?    @relation(fields: [unitId], references: [id])
  actor   User?    @relation("PriceChangeActor", fields: [actorId], references: [id])

  @@index([companyId, createdAt])
  @@index([productId])
  @@index([unitId])
  @@map("price_change_events")
}

model StockItem {
  id        Bytes    @id @db.Binary(16)
  companyId Bytes    @map("company_id") @db.Binary(16)
  productId Bytes    @map("product_id") @db.Binary(16)
  branchId  Bytes    @map("branch_id") @db.Binary(16)
  quantity  Int      @default(0) // CHECK (>=0) in 0002
  cost      Decimal  @db.Decimal(14, 2)
  /// Branch selling price. NULLABLE since `0034`: a transfer can deliver stock
  /// into a branch that has never priced it, and neither inventing a price nor
  /// refusing the goods is acceptable. NULL means "unpriced" and falls through
  /// to `Product.defaultPrice`, then to the `unpriced` state the price ladder
  /// already models. It is never treated as zero.
  price     Decimal? @db.Decimal(14, 2)
  /// Physically owned at this branch. NEVER reduced to express unavailability —
  /// reserved goods are still company property and still count in valuation.
  /// Promised to an open transfer and therefore NOT sellable (0030).
  /// Available to sell = `quantity - reservedQuantity`, enforced by CHECKs.
  reservedQuantity Int @default(0) @map("reserved_quantity")
  /// Optimistic concurrency for branch price edits (0029). `updatedAt` cannot
  /// serve: MySQL keeps microseconds, a JS Date only milliseconds.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@map("stock_items")
}

// -------------------- Suppliers, Purchases & Sales -------------------------

model Supplier {
  id        Bytes     @id @db.Binary(16)
  companyId Bytes     @map("company_id") @db.Binary(16)
  name      String    @db.VarChar(160)
  phone     String?   @db.VarChar(40)
  notes     String?   @db.Text
  /// A CACHE, not the truth (`0039`).
  ///
  /// Outstanding payable is derived from immutable rows: purchase totals minus
  /// confirmed payment allocations. This counter is maintained for
  /// compatibility and compared against the derived figure by a drift test, but
  /// nothing decides anything from it — a debt that lives in a mutable counter
  /// is a debt that can silently disappear.
  balance   Decimal   @default(0) @db.Decimal(14, 2)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(6)

  company   Company           @relation(fields: [companyId], references: [id])
  purchases Purchase[]
  units     Unit[]
  payments  SupplierPayment[]
  settlements SupplierSettlement[]

  @@unique([companyId, name]) // company_id leftmost → covers company scans
  @@map("suppliers")
}

model Purchase {
  id          Bytes          @id @db.Binary(16)
  companyId   Bytes          @map("company_id") @db.Binary(16)
  branchId    Bytes          @map("branch_id") @db.Binary(16)
  supplierId  Bytes          @map("supplier_id") @db.Binary(16)
  userId      Bytes?         @map("user_id") @db.Binary(16)
  referenceNo String?        @map("reference_no") @db.VarChar(40)
  /// Client-generated request identity for safe retries (see 0013).
  clientUuid  Bytes?         @map("client_uuid") @db.Binary(16)
  /// sha256 of the request payload, so a replayed key with different content
  /// is a conflict rather than a wrong "already done".
  clientRequestHash String?  @map("client_request_hash") @db.Char(64)
  date        DateTime       @default(now()) @db.DateTime(6)
  subtotal    Decimal        @db.Decimal(14, 2)
  taxTotal    Decimal        @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  amountPaid  Decimal        @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status      PurchaseStatus @default(unpaid)
  dueDate     DateTime?      @map("due_date") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.DateTime(6)

  company  Company           @relation(fields: [companyId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  supplier Supplier          @relation(fields: [supplierId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  units    Unit[]
  payments SupplierPayment[]
  allocations SupplierSettlementAllocation[]

  @@index([companyId, branchId, date])
  @@index([supplierId])
  @@index([userId])
  @@unique([companyId, clientUuid])
  @@map("purchases")
}

model PurchaseItem {
  id         Bytes   @id @db.Binary(16)
  companyId  Bytes   @map("company_id") @db.Binary(16)
  purchaseId Bytes   @map("purchase_id") @db.Binary(16)
  productId  Bytes   @map("product_id") @db.Binary(16)
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)

  company  Company  @relation(fields: [companyId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([companyId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id          Bytes         @id @db.Binary(16)
  companyId   Bytes         @map("company_id") @db.Binary(16)
  supplierId  Bytes         @map("supplier_id") @db.Binary(16)
  purchaseId  Bytes?        @map("purchase_id") @db.Binary(16)
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paidAt      DateTime      @default(now()) @map("paid_at") @db.DateTime(6)
  createdById Bytes?        @map("created_by") @db.Binary(16)

  company   Company   @relation(fields: [companyId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  purchase  Purchase? @relation(fields: [purchaseId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([companyId, supplierId])
  @@index([purchaseId])
  @@index([createdById])
  @@map("supplier_payments")
}

model Customer {
  id        Bytes     @id @db.Binary(16)
  companyId Bytes     @map("company_id") @db.Binary(16)
  name      String?   @db.VarChar(160)
  phone     String?   @db.VarChar(40)
  notes     String?   @db.Text
  balance   Decimal   @default(0) @db.Decimal(14, 2)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  sales   Sale[]

  @@index([companyId])
  @@map("customers")
}

/// Queued teach-on-confirm events, written in the SAME transaction as the
/// purchase so a crash cannot lose learning. Unique per (company, purchase,
/// code) — replaying a purchase or a sweep cannot double-count evidence.
model RecognitionOutbox {
  id          Bytes     @id @db.Binary(16)
  companyId   Bytes     @map("company_id") @db.Binary(16)
  purchaseId  Bytes?    @map("purchase_id") @db.Binary(16)
  codeType    String    @map("code_type") @db.VarChar(16)
  code        String    @db.VarChar(64)
  productId   Bytes     @map("product_id") @db.Binary(16)
  supplierId  Bytes?    @map("supplier_id") @db.Binary(16)
  source      String    @db.VarChar(32)
  /// pending | processing | done | failed
  status      String    @default("pending") @db.VarChar(16)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  processedAt DateTime? @map("processed_at") @db.DateTime(6)
  /// Lease deadline. An expired lease means the worker died; the row is
  /// claimable again without manual intervention.
  claimedUntil DateTime? @map("claimed_until") @db.DateTime(6)
  /// Exponential backoff, so one permanently failing row cannot hammer the DB.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, purchaseId, codeType, code])
  @@index([status, updatedAt])
  @@index([status, nextAttemptAt, claimedUntil])
  @@map("recognition_outbox")
}

model Sale {
  id         Bytes         @id @db.Binary(16)
  companyId  Bytes         @map("company_id") @db.Binary(16)
  branchId   Bytes         @map("branch_id") @db.Binary(16)
  userId     Bytes         @map("user_id") @db.Binary(16)
  customerId Bytes?        @map("customer_id") @db.Binary(16)
  invoiceNo  String        @map("invoice_no") @db.VarChar(24)
  soldAt     DateTime      @default(now()) @map("sold_at") @db.DateTime(6)
  subtotal   Decimal       @db.Decimal(14, 2)
  discount   Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total      Decimal       @db.Decimal(14, 2)
  totalCost  Decimal       @map("total_cost") @db.Decimal(14, 2)
  margin     Decimal       @db.Decimal(14, 2)
  amountPaid Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balanceDue Decimal       @default(0) @map("balance_due") @db.Decimal(14, 2)
  payStatus  SalePayStatus @default(paid) @map("pay_status")
  dueDate    DateTime?     @map("due_date") @db.Date
  isReversed Boolean       @default(false) @map("is_reversed")

  /// The return policy THIS sale was sold under, snapshotted at completion
  /// (I1). `0` means no returns. Deliberately not read from
  /// `company_settings` at return time: an Owner shortening the window
  /// tomorrow must not retroactively cancel a right already promised, and
  /// lengthening it must not silently grant one nobody offered.
  returnWindowHours Int @default(0) @map("return_window_hours")
  /// `soldAt + returnWindowHours`, computed by the SERVER in UTC and never
  /// updated. NULL when the window is 0 — "no deadline" and "deadline passed"
  /// are different facts and must not share a representation. A CHECK keeps
  /// the pair consistent.
  returnDeadlineAt DateTime? @map("return_deadline_at") @db.DateTime(6)
  /// Set only when a Manager or Owner changed the policy at sale time.
  returnPolicyOverriddenById Bytes?  @map("return_policy_overridden_by") @db.Binary(16)
  returnPolicyOverrideReason String? @map("return_policy_override_reason") @db.VarChar(255)

  clientUuid Bytes?        @map("client_uuid") @db.Binary(16)
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.DateTime(6)

  company  Company   @relation(fields: [companyId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  returnPolicyOverriddenBy User? @relation("SaleReturnPolicyOverride", fields: [returnPolicyOverriddenById], references: [id])
  items    SaleItem[]
  payments Payment[]
  returnRequests  ReturnRequest[]
  returnReversals ReturnReversal[]
    returns  Return[]

  @@unique([branchId, invoiceNo])
  @@unique([companyId, clientUuid])
  @@index([companyId, returnDeadlineAt], map: "sales_return_deadline_idx")
  @@index([companyId, branchId, soldAt])
  @@index([companyId, userId, soldAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        Bytes   @id @db.Binary(16)
  companyId Bytes   @map("company_id") @db.Binary(16)
  saleId    Bytes   @map("sale_id") @db.Binary(16)
  unitId    Bytes?  @map("unit_id") @db.Binary(16)
  productId Bytes?  @map("product_id") @db.Binary(16)
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(14, 2)
  cost      Decimal @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  voided    Boolean @default(false)

  company Company  @relation(fields: [companyId], references: [id])
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnRequests  ReturnRequest[]
  returnReversal  ReturnReversal?
    returns Return[]

  // sold-once: generated column `active_unit_id` + UNIQUE + CHECK added in 0002
  @@index([saleId])
  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id        Bytes         @id @db.Binary(16)
  companyId Bytes         @map("company_id") @db.Binary(16)
  saleId    Bytes         @map("sale_id") @db.Binary(16)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  paidAt    DateTime      @default(now()) @map("paid_at") @db.DateTime(6)

  /// Which account the money landed in (0045). Money going OUT was already
  /// attributed — `refund_payouts`, `supplier_settlements` and `expenses` all
  /// carry this — but money coming IN was not, so no account could have an
  /// expected balance of its own.
  ///
  /// NULL means unattributed: every payment taken before 0045, and any non-cash
  /// payment where the till did not identify an account. Unattributed money is
  /// reported as its own line and is never folded into a real account's
  /// expected figure — guessing which account an old sale reached would be
  /// inventing a financial record.
  ///
  /// Always NULL for cash, enforced by `ck_payments_cash_no_account`.
  receivingAccountId   Bytes?  @map("receiving_account_id") @db.Binary(16)
  /// Frozen at the moment of payment, like every other account reference here.
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)

  company          Company           @relation(fields: [companyId], references: [id])
  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receivingAccount ReceivingAccount? @relation(fields: [receivingAccountId], references: [id])

  @@index([saleId])
  @@index([companyId])
  @@index([companyId, receivingAccountId], map: "ix_payments_account")
  @@map("payments")
}

model Return {
  id           Bytes    @id @db.Binary(16)
  companyId    Bytes    @map("company_id") @db.Binary(16)
  saleId       Bytes    @map("sale_id") @db.Binary(16)
  saleItemId   Bytes?   @map("sale_item_id") @db.Binary(16)
  unitId       Bytes?   @map("unit_id") @db.Binary(16)
  reason       String?  @db.VarChar(255)
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(14, 2)
  restock      Boolean  @default(true)
  returnedAt   DateTime @default(now()) @map("returned_at") @db.DateTime(6)
  createdById  Bytes?   @map("created_by") @db.Binary(16)

  company  Company   @relation(fields: [companyId], references: [id])
  sale     Sale      @relation(fields: [saleId], references: [id])
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([companyId, saleId])
  @@index([saleItemId])
  @@index([unitId])
  @@index([createdById])
  @@map("returns")
}

// ---------------------------- Branch Transfers -----------------------------

model StockTransfer {
  id           Bytes          @id @db.Binary(16)
  companyId    Bytes          @map("company_id") @db.Binary(16)
  fromBranchId Bytes          @map("from_branch_id") @db.Binary(16)
  toBranchId   Bytes          @map("to_branch_id") @db.Binary(16)
  transferNo   String?        @map("transfer_no") @db.VarChar(24)
  /// Defaults to the UNAPPROVED state deliberately: a row that somehow reaches
  /// the database without the service choosing a status must not be shippable.
  status       TransferStatus @default(pending_approval)
  sentById     Bytes?         @map("sent_by") @db.Binary(16)
  receivedById Bytes?         @map("received_by") @db.Binary(16)
  sentAt       DateTime       @default(now()) @map("sent_at") @db.DateTime(6)
  receivedAt   DateTime?      @map("received_at") @db.DateTime(6)
  /// Client-generated request id (H1.1). Mandatory on create; nullable only so
  /// the column can be added to a database that already holds transfers.
  clientUuid        Bytes?  @map("client_uuid") @db.Binary(16)
  /// Fingerprint of the create payload, so replaying a key with a DIFFERENT
  /// request is a 409 rather than a silent no-op. Same pattern as Purchase.
  clientRequestHash String? @map("client_request_hash") @db.Char(64)

  /// Optimistic concurrency for every lifecycle transition (H1.2). Two managers
  /// acting on one request — approve vs reject, ship vs cancel — must not both
  /// succeed, and the loser must be told rather than silently overwritten.
  version      Int       @default(0)
  /// Who created the request. `sentById` records who SHIPPED it, which is a
  /// different person under the approval workflow.
  requestedById Bytes?   @map("requested_by") @db.Binary(16)
  approvedById Bytes?    @map("approved_by") @db.Binary(16)
  approvedAt   DateTime? @map("approved_at") @db.DateTime(6)
  /// True when the requester already held `transfer.approve` in the source
  /// branch, so the request was born approved. Recorded because "approved with
  /// no approver" would otherwise look like a gap in the audit trail.
  autoApproved Boolean   @default(false) @map("auto_approved")
  /// Why it was rejected or cancelled. Mandatory for both at the API.
  decisionReason String? @map("decision_reason") @db.Text
  decidedById  Bytes?    @map("decided_by") @db.Binary(16)
  decidedAt    DateTime? @map("decided_at") @db.DateTime(6)

  company    Company        @relation(fields: [companyId], references: [id])
  fromBranch Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  sentBy      User?         @relation("TransferSentBy", fields: [sentById], references: [id])
  receivedBy  User?         @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  requestedBy User?         @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?         @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  decidedBy   User?         @relation("TransferDecidedBy", fields: [decidedById], references: [id])
  items      TransferItem[]

  @@unique([fromBranchId, transferNo])
  /// One request id per company. MySQL permits many NULLs, so pre-H1.1 rows are
  /// unaffected, and two concurrent identical creates cannot both win.
  @@unique([companyId, clientUuid])
  @@index([companyId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([sentById])
  @@index([receivedById])
  @@map("stock_transfers")
}

/// One line of a transfer, and exactly one KIND of line (`0034`).
///
/// - **Serialized:** `unitId` set, `productId` NULL, `quantity` 1.
/// - **Quantity:** `productId` set, `unitId` NULL, `quantity` >= 1.
///
/// A CHECK enforces the exclusivity, so "both" and "neither" are states the
/// database refuses rather than states the service is trusted to avoid. A
/// quantity line names its source stock row through the parent transfer's
/// `fromBranchId`: `stock_items` is UNIQUE on `(companyId, productId, branchId)`,
/// so the pair resolves to exactly one row and a second id column would only be
/// a second source of truth for the same fact.
model TransferItem {
  id         Bytes  @id @db.Binary(16)
  companyId  Bytes  @map("company_id") @db.Binary(16)
  transferId Bytes  @map("transfer_id") @db.Binary(16)
  unitId     Bytes? @map("unit_id") @db.Binary(16)
  productId  Bytes? @map("product_id") @db.Binary(16)
  quantity   Int    @default(1)
  /// Source cost captured AT SHIPMENT, on quantity lines only (`0034`).
  ///
  /// NULL until the transfer ships; set as part of the same transaction that
  /// decrements the source. It is the value that travels: while the goods are
  /// in transit they are worth `quantity * shippedUnitCost`, and it is what the
  /// destination averages in on receipt. Cost is read at shipment rather than at
  /// request because a cost that changed while the request waited for approval
  /// is not the cost of the goods that actually left.
  ///
  /// **"NULL before shipment, set after" is a service invariant, not a CHECK** —
  /// it depends on the parent transfer's status, and MySQL CHECK constraints
  /// cannot see another table. Tests pin it.
  shippedUnitCost Decimal? @map("shipped_unit_cost") @db.Decimal(14, 2)

  company  Company       @relation(fields: [companyId], references: [id])
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  /// `Restrict`, not Prisma's default `SetNull` for an optional relation
  /// (`0034`). Two reasons, and the first was observed rather than theorised:
  /// deleting a unit used to silently NULL this column and leave a transfer line
  /// pointing at nothing, which is a movement record that has forgotten what it
  /// moved. Second, MySQL refuses a CHECK constraint on any column whose foreign
  /// key carries a referential action, so the line-kind CHECK is only possible
  /// with these two set to `Restrict`.
  unit     Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product  Product?      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One line per product per transfer. MySQL lets NULLs repeat under a unique
  /// index, so serialized rows — all of which have `productId` NULL — are
  /// untouched by it. This is what makes "the same accessory twice in one
  /// request" a rejection the DATABASE makes, so no ordering of concurrent
  /// inserts can slip a duplicate past an application check.
  @@unique([transferId, productId])
  @@index([transferId])
  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@map("transfer_items")
}

// ------------------ Finance, Closing & Notification Center -----------------

model ExpenseTemplate {
  id         Bytes             @id @db.Binary(16)
  companyId  Bytes             @map("company_id") @db.Binary(16)
  branchId   Bytes?            @map("branch_id") @db.Binary(16)
  category   String            @db.VarChar(60)
  amount     Decimal           @db.Decimal(14, 2)
  recurrence ExpenseRecurrence @default(monthly)
  dayOfMonth Int?              @map("day_of_month") @db.SmallInt
  isActive   Boolean           @default(true) @map("is_active")

  company  Company   @relation(fields: [companyId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  expenses Expense[]

  @@index([companyId])
  @@index([branchId])
  @@map("expense_templates")
}

model Expense {
  id          Bytes    @id @db.Binary(16)
  companyId   Bytes    @map("company_id") @db.Binary(16)
  branchId    Bytes?   @map("branch_id") @db.Binary(16)
  templateId  Bytes?   @map("template_id") @db.Binary(16)
  category    String   @db.VarChar(60)
  amount      Decimal  @db.Decimal(14, 2)
  spentOn     DateTime @map("spent_on") @db.Date
  note        String?  @db.Text
  /// `reported` moves NO money and reaches no report. Only `confirmed` does.
  status      ExpenseStatus @default(confirmed)
  /// `variable` belongs to the day it is CONFIRMED; `fixed` to its DUE date,
  /// and is never spread across every day.
  expenseClass ExpenseClass @default(variable) @map("expense_class")
  /// Salaries stay separately reportable from other fixed costs.
  isSalary    Boolean  @default(false) @map("is_salary")
  /// The date a FIXED expense is recognised on. Null for variable.
  dueDate     DateTime? @map("due_date") @db.Date
  /// Only `cash` touches the drawer.
  method      RefundMethod @default(cash)
  receivingAccountId Bytes? @map("receiving_account_id") @db.Binary(16)
  /// Frozen when REPORTED, so a later rename cannot retitle a movement that
  /// already happened, and deactivation cannot strand a confirmation.
  accountLabelSnapshot String? @map("account_label_snapshot") @db.VarChar(80)
  reference   String?  @db.VarChar(120)
  /// An explicit state, never invented placeholder copy: "Miscellaneous" in a
  /// ledger is indistinguishable from a real category a year later.
  reasonOmitted Boolean @default(false) @map("reason_omitted")
  reportedById Bytes?  @map("reported_by_id") @db.Binary(16)
  reportedAt   DateTime? @map("reported_at") @db.DateTime(6)
  confirmedById Bytes? @map("confirmed_by_id") @db.Binary(16)
  confirmedAt   DateTime? @map("confirmed_at") @db.DateTime(6)
  /// The business day the cash movement belongs to.
  confirmationDate DateTime? @map("confirmation_date") @db.Date
  rejectedReason String? @map("rejected_reason") @db.VarChar(255)
  clientUuid   Bytes?  @map("client_uuid") @db.Binary(16)
  clientRequestHash String? @map("client_request_hash") @db.Char(64)
  version      Int     @default(0)
  createdById Bytes?   @map("created_by") @db.Binary(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch?          @relation(fields: [branchId], references: [id])
  template  ExpenseTemplate? @relation(fields: [templateId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])
  receivingAccount ReceivingAccount? @relation(fields: [receivingAccountId], references: [id])
  reportedBy  User? @relation("ExpenseReportedBy", fields: [reportedById], references: [id])
  confirmedBy User? @relation("ExpenseConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([companyId, clientUuid])
  @@index([companyId, branchId, confirmationDate, status])
  @@index([companyId, branchId, dueDate, status])
  @@index([companyId, branchId, spentOn])
  @@index([templateId])
  @@index([createdById])
  @@map("expenses")
}

model DailyClosing {
  id           Bytes    @id @db.Binary(16)
  companyId    Bytes    @map("company_id") @db.Binary(16)
  branchId     Bytes    @map("branch_id") @db.Binary(16)
  closingDate  DateTime @map("closing_date") @db.Date
  expectedCash Decimal  @map("expected_cash") @db.Decimal(14, 2)
  countedCash  Decimal  @map("counted_cash") @db.Decimal(14, 2)
  difference   Decimal  @db.Decimal(14, 2)
  totalSales   Decimal  @map("total_sales") @db.Decimal(14, 2)
  totalProfit  Decimal  @map("total_profit") @db.Decimal(14, 2)

  /// What was returned on the day this closing locked (I2). A closing created
  /// AFTER an approval records it; an approval on an already-locked day is
  /// refused with a 409 rather than reopening anything. Existing closings keep
  /// 0, which is the literal truth — no return had been approved when they were
  /// written.
  totalReturns             Decimal @default(0) @map("total_returns") @db.Decimal(14, 2)
  totalReturnsProfitImpact Decimal @default(0) @map("total_returns_profit_impact") @db.Decimal(14, 2)
  totalReturnAdjustments   Decimal @default(0) @map("total_return_adjustments") @db.Decimal(14, 2)
  totalReturnsCogsCredited Decimal @default(0) @map("total_returns_cogs_credited") @db.Decimal(14, 2)
  /// Refunds confirmed on the day this closing locked. Cash movement only.
  refundsPaidTotal         Decimal @default(0) @map("refunds_paid_total") @db.Decimal(14, 2)
  refundsPaidCash          Decimal @default(0) @map("refunds_paid_cash") @db.Decimal(14, 2)
  /// Money returned to the till because a confirmed payment was corrected
  /// (Milestone B), keyed on the CORRECTION day — never the original payment's.
  correctionsTotal         Decimal @default(0) @map("corrections_total") @db.Decimal(14, 2)
  correctionsCash          Decimal @default(0) @map("corrections_cash") @db.Decimal(14, 2)
  /// Cash expenses confirmed on this day — the part that left the drawer.
  expensesCash             Decimal @default(0) @map("expenses_cash") @db.Decimal(14, 2)
  /// Supplier payments CONFIRMED on this day (0039). A balance-sheet
  /// movement, never an expense and never COGS - it appears in no profit
  /// figure. Only the cash part left the drawer.
  supplierPaidTotal Decimal @default(0) @map("supplier_paid_total") @db.Decimal(14, 2)
  supplierPaidCash  Decimal @default(0) @map("supplier_paid_cash") @db.Decimal(14, 2)
  /// The closing lifecycle (0045). Counting and signing off became two acts,
  /// because `closing.perform` did both and the Employee holding the drawer
  /// held neither — so nobody junior could report what was in the till.
  ///
  /// `locked` is the DEFAULT so every closing written before 0045 keeps exactly
  /// the meaning it had: counted and signed off in one step.
  status      ClosingStatus @default(locked)
  countedById Bytes?        @map("counted_by_id") @db.Binary(16)
  countedAt   DateTime?     @map("counted_at") @db.DateTime(6)
  /// Optimistic concurrency: two people finishing one day, one winner.
  version     Int           @default(0)

  isLocked     Boolean  @default(true) @map("is_locked")
  notes        String?  @db.Text
  closedById   Bytes?   @map("closed_by") @db.Binary(16)
  closedAt     DateTime @default(now()) @map("closed_at") @db.DateTime(6)

  company   Company      @relation(fields: [companyId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  closedBy  User?        @relation(fields: [closedById], references: [id])
  countedBy User?        @relation("ClosingCountedBy", fields: [countedById], references: [id])
  digest    DailyDigest?

  channelCounts ClosingChannelCount[]
  discrepancies ClosingDiscrepancy[]

  @@unique([branchId, closingDate])
  @@index([companyId])
  @@index([closedById])
  @@map("daily_closings")
}

/// Where a closing is in its lifecycle (0045).
enum ClosingStatus {
  /// Open. Figures still move as the day's work is confirmed.
  counting
  /// A count has been entered. Not signed off — the day is still correctable.
  counted
  /// Signed off. The figures are a snapshot and never move again.
  locked
}

enum ClosingChannel {
  cash
  account
}

/// One channel's expected and counted figures on a closing (0045).
///
/// Before this, the closing was a single cash figure, so a shop taking Bankily
/// had no expected balance for it and an account could drift indefinitely with
/// nothing noticing.
model ClosingChannelCount {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  closingId Bytes @map("closing_id") @db.Binary(16)

  channel ClosingChannel
  /// NULL for cash, and NULL for the unattributed bucket of a method whose
  /// payments never named an account.
  receivingAccountId Bytes? @map("receiving_account_id") @db.Binary(16)
  /// Frozen. Renaming an account must not retitle a movement already recorded.
  labelSnapshot      String @map("label_snapshot") @db.VarChar(80)

  /// The same five movements the cash equation is built from, per channel:
  ///   expected = salesIn − refundsOut − supplierOut − expensesOut + correctionsIn
  /// Stored individually so a channel can answer for its own figure rather than
  /// merely assert it.
  salesIn       Decimal @default(0) @map("sales_in") @db.Decimal(14, 2)
  refundsOut    Decimal @default(0) @map("refunds_out") @db.Decimal(14, 2)
  supplierOut   Decimal @default(0) @map("supplier_out") @db.Decimal(14, 2)
  expensesOut   Decimal @default(0) @map("expenses_out") @db.Decimal(14, 2)
  correctionsIn Decimal @default(0) @map("corrections_in") @db.Decimal(14, 2)

  expected Decimal @default(0) @db.Decimal(14, 2)
  /// NULL means genuinely not counted yet, which is not the same as counted as
  /// zero. A shop that has not checked its Bankily balance must not read as
  /// balanced.
  counted    Decimal? @db.Decimal(14, 2)
  difference Decimal? @db.Decimal(14, 2)

  /// An account balance is a running total, not a till. It is reconcilable only
  /// when the shop can actually read the figure, so a channel may be skipped
  /// WITH a reason — skipping is recorded, never inferred from a missing count.
  isSkipped  Boolean @default(false) @map("is_skipped")
  skipReason String? @map("skip_reason") @db.VarChar(255)

  countedById Bytes?    @map("counted_by_id") @db.Binary(16)
  countedAt   DateTime? @map("counted_at") @db.DateTime(6)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company          Company              @relation(fields: [companyId], references: [id])
  closing          DailyClosing         @relation(fields: [closingId], references: [id])
  receivingAccount ReceivingAccount?    @relation(fields: [receivingAccountId], references: [id])
  countedBy        User?                @relation("ChannelCountedBy", fields: [countedById], references: [id])
  discrepancies    ClosingDiscrepancy[]

  // Uniqueness is on the generated `channel_key` (0045), because MySQL has no
  // partial unique index and a NULL account would let one channel appear twice.
  @@index([companyId])
  @@index([receivingAccountId])
  @@map("closing_channel_counts")
}

enum DiscrepancyStatus {
  /// Where every discrepancy opens. Never auto-assigned to anybody — the system
  /// observes that the drawer is short, it does not accuse whoever was counting.
  pending_investigation
  resolved
}

enum DiscrepancyResolution {
  /// A person accepted responsibility. Writes a ledger row.
  employee_debt
  /// The business takes the loss.
  store_absorbed
  /// The money was never missing; a record was wrong.
  error_corrected
  /// Responsibility identified, then waived.
  forgiven
}

/// A difference that somebody has to answer for (0045).
///
/// Before this, `difference` was a number on a locked row: no investigation, no
/// decision, no record of who was held responsible. So a shortage was either
/// silently absorbed or settled verbally.
model ClosingDiscrepancy {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  branchId  Bytes @map("branch_id") @db.Binary(16)
  closingId Bytes @map("closing_id") @db.Binary(16)
  /// Which channel was out. NULL only for a legacy cash-only closing.
  channelCountId Bytes? @map("channel_count_id") @db.Binary(16)

  /// Signed: negative is a shortage, positive is a surplus. A surplus is
  /// investigated too — unexplained extra money is a mis-recorded sale until
  /// somebody shows otherwise.
  amount Decimal @db.Decimal(14, 2)

  status            DiscrepancyStatus      @default(pending_investigation)
  resolution        DiscrepancyResolution?
  responsibleUserId Bytes?                 @map("responsible_user_id") @db.Binary(16)
  /// Mandatory on resolution. There is no resolving a shortage silently.
  resolutionReason  String?                @map("resolution_reason") @db.VarChar(255)

  openedAt     DateTime  @default(now()) @map("opened_at") @db.DateTime(6)
  resolvedById Bytes?    @map("resolved_by_id") @db.Binary(16)
  resolvedAt   DateTime? @map("resolved_at") @db.DateTime(6)

  version Int @default(0)

  company         Company              @relation(fields: [companyId], references: [id])
  branch          Branch               @relation(fields: [branchId], references: [id])
  closing         DailyClosing         @relation(fields: [closingId], references: [id])
  channelCount    ClosingChannelCount? @relation(fields: [channelCountId], references: [id])
  responsibleUser User?                @relation("DiscrepancyResponsible", fields: [responsibleUserId], references: [id])
  resolvedBy      User?                @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])
  debtEntries     EmployeeDebtEntry[]

  @@index([companyId, branchId, status])
  @@index([closingId])
  @@index([responsibleUserId])
  @@index([channelCountId])
  @@index([resolvedById])
  @@map("closing_discrepancies")
}

enum DebtEntryKind {
  /// A shortage the person accepted. Increases what is owed.
  charge
  /// Money handed back. Decreases it.
  repayment
  /// Withheld from pay. Decreases it.
  deduction
  /// Written off. Decreases it, and the business bears it.
  forgiveness
}

enum DebtRepaymentMethod {
  cash
  account
  payroll
}

/// The employee debt ledger (0045) — append-only, like every other financial
/// record here.
///
/// What somebody owes is DERIVED from these rows and stored nowhere:
///   balance = charges − repayments − deductions − forgiveness
/// A stored balance can disagree with its own history. A derived one cannot.
model EmployeeDebtEntry {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  branchId  Bytes @map("branch_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)
  /// Where it came from. NULL for a repayment against an older balance.
  discrepancyId Bytes? @map("discrepancy_id") @db.Binary(16)

  kind DebtEntryKind
  /// Always a positive magnitude — `kind` carries the direction, so no row can
  /// be ambiguous about which way the money went.
  amount Decimal @db.Decimal(14, 2)

  /// Mandatory, every kind, no exception. A ledger row nobody can explain is
  /// worse than no ledger at all.
  reason    String               @db.VarChar(255)
  /// How a repayment arrived. NULL for the other kinds.
  method    DebtRepaymentMethod?
  reference String?              @db.VarChar(120)

  entryDate   DateTime @map("entry_date") @db.Date
  createdById Bytes    @map("created_by_id") @db.Binary(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)

  /// An offline retry must not charge somebody twice.
  clientUuid Bytes? @map("client_uuid") @db.Binary(16)

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  user        User                @relation("DebtSubject", fields: [userId], references: [id])
  createdBy   User                @relation("DebtCreatedBy", fields: [createdById], references: [id])
  discrepancy ClosingDiscrepancy? @relation(fields: [discrepancyId], references: [id])

  @@unique([companyId, clientUuid], map: "ux_debt_client_uuid")
  @@index([companyId, userId, entryDate])
  @@index([discrepancyId])
  @@index([branchId])
  @@index([createdById])
  @@map("employee_debt_entries")
}

model DailyDigest {
  id              Bytes    @id @db.Binary(16)
  companyId       Bytes    @map("company_id") @db.Binary(16)
  branchId        Bytes    @map("branch_id") @db.Binary(16)
  closingId       Bytes?   @unique @map("closing_id") @db.Binary(16)
  digestDate      DateTime @map("digest_date") @db.Date
  revenue         Decimal  @db.Decimal(14, 2)
  costOfGoodsSold Decimal  @map("cost_of_goods_sold") @db.Decimal(14, 2)
  grossProfit     Decimal  @map("gross_profit") @db.Decimal(14, 2)
  generatedAt     DateTime @default(now()) @map("generated_at") @db.DateTime(6)

  company Company       @relation(fields: [companyId], references: [id])
  branch  Branch        @relation(fields: [branchId], references: [id])
  closing DailyClosing? @relation(fields: [closingId], references: [id])
  lines   DigestLine[]

  @@unique([branchId, digestDate])
  @@index([companyId])
  @@map("daily_digests")
}

model DigestLine {
  id           Bytes          @id @db.Binary(16)
  companyId    Bytes          @map("company_id") @db.Binary(16)
  digestId     Bytes          @map("digest_id") @db.Binary(16)
  identifier   String?        @db.VarChar(64) // tracked unit identifier (IMEI or serial); null for quantity
  productLabel String?        @map("product_label") @db.VarChar(200)
  employeeId   Bytes?         @map("employee_id") @db.Binary(16)
  salePrice    Decimal?       @map("sale_price") @db.Decimal(14, 2)
  purchaseCost Decimal?       @map("purchase_cost") @db.Decimal(14, 2)
  profit       Decimal?       @db.Decimal(14, 2)
  method       PaymentMethod?
  soldAt       DateTime?      @map("sold_at") @db.DateTime(6)

  company  Company     @relation(fields: [companyId], references: [id])
  digest   DailyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  employee User?       @relation(fields: [employeeId], references: [id])

  @@index([digestId])
  @@index([companyId])
  @@index([employeeId])
  @@map("digest_lines")
}

// -------- System: Notifications, Import, Reports, Audit, Sync, Settings -----

model Notification {
  id           Bytes    @id @db.Binary(16)
  companyId    Bytes    @map("company_id") @db.Binary(16)
  branchId     Bytes?   @map("branch_id") @db.Binary(16)
  targetUserId Bytes?   @map("target_user_id") @db.Binary(16)
  type         String   @db.VarChar(60)
  title        String   @db.VarChar(200)
  body         String?  @db.Text
  actionLink   String?  @map("action_link") @db.VarChar(255)
  /// Natural identity of the event this notification reports, e.g.
  /// `transfer:<hex>:approved` (H1.3). The unique index below makes a duplicate
  /// an INSERT the database rejects rather than one the application tries to
  /// avoid — an application-level pre-check is true when read and false when
  /// acted on. NULL for notifications that have no natural identity; NULLs do
  /// not collide in a MySQL unique index, so those behave as ordinary inserts.
  dedupeKey    String?  @map("dedupe_key") @db.VarChar(120)
  /// The FIELDS of the message (branch names, transfer reference, counts, actor,
  /// reason) so the app can compose the sentence in the reader's language;
  /// `title`/`body` stay as the fallback. Carries no cost, price or margin — a
  /// notification is read outside the request that authorized it.
  payload      Json?    @db.Json
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])
  targetUser User?   @relation(fields: [targetUserId], references: [id])

  @@unique([companyId, targetUserId, dedupeKey], map: "notifications_company_target_dedupe_key")
  @@index([companyId, targetUserId, isRead, createdAt])
  @@index([branchId])
  @@map("notifications")
}

model ImportBatch {
  id        Bytes        @id @db.Binary(16)
  companyId Bytes        @map("company_id") @db.Binary(16)
  branchId  Bytes        @map("branch_id") @db.Binary(16)
  userId    Bytes?       @map("user_id") @db.Binary(16)
  fileRef   String       @map("file_ref") @db.VarChar(512)
  status    ImportStatus @default(parsing)
  totalRows Int          @default(0) @map("total_rows")
  validRows Int          @default(0) @map("valid_rows")
  errorRows Int          @default(0) @map("error_rows")

  /// What the sheet describes, decided by which identifier column it carries
  /// rather than asked. A column of IMEIs is phones (0048).
  kind             ImportKind?
  /// What the shop actually called their file; `fileRef` is a storage key.
  originalFilename String?     @map("original_filename") @db.VarChar(255)
  /// The confirmed column mapping, frozen at preview. The commit reads this and
  /// never re-guesses, or a shop approves one interpretation and receives
  /// stock built from another.
  mapping          Json?       @db.Json
  /// Rows that will import but are worth a look. There was no counter at all.
  warningRows      Int         @default(0) @map("warning_rows")
  /// How many rows the commit actually created — not the same as how many the
  /// preview predicted, if anything changed in between.
  importedRows     Int         @default(0) @map("imported_rows")
  committedAt      DateTime?   @map("committed_at") @db.DateTime(6)
  committedById    Bytes?      @map("committed_by_id") @db.Binary(16)
  /// An offline retry must not import the same file twice.
  clientUuid       Bytes?      @map("client_uuid") @db.Binary(16)
  version          Int         @default(0)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(6)

  company Company     @relation(fields: [companyId], references: [id])
  branch  Branch      @relation(fields: [branchId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  committedBy User?       @relation("ImportCommittedBy", fields: [committedById], references: [id])
  rows        ImportRow[]

  @@index([companyId])
  @@index([branchId])
  @@unique([companyId, clientUuid], map: "ux_import_batches_client_uuid")
  @@index([userId])
  @@index([companyId, branchId, status, createdAt], map: "ix_import_batches_status")
  @@map("import_batches")
}

model ImportRow {
  id        Bytes           @id @db.Binary(16)
  companyId Bytes           @map("company_id") @db.Binary(16)
  batchId   Bytes           @map("batch_id") @db.Binary(16)
  rowNumber Int             @map("row_number")
  raw       Json?           @db.Json
  parsed    Json?           @db.Json
  status    ImportRowStatus
  message   String?         @db.Text

  /// The unit or stock row this line produced (0048). Without it there is no
  /// way to get from line 47 of a spreadsheet to the phone it created, which is
  /// the first thing anybody asks when an import looks wrong.
  ///
  /// Not a relation: it points at one of two tables depending on the batch
  /// kind, and a row that produced nothing keeps null.
  createdEntityId Bytes?              @map("created_entity_id") @db.Binary(16)
  createdKind     ImportCreatedKind?  @map("created_kind")
  /// The identifier this row claimed, extracted so duplicate detection and the
  /// commit need not re-read the JSON.
  identifier      String?             @db.VarChar(64)

  company Company     @relation(fields: [companyId], references: [id])
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([companyId])
  @@index([companyId, identifier], map: "ix_import_rows_identifier")
  @@index([batchId, status], map: "ix_import_rows_batch_status")
  @@map("import_rows")
}

