// Auth sessions — one row per active login/device. Backs rotating refresh tokens
// and per-device revocation (see docs/15_SECURITY_ARCHITECTURE.md §5, §7, §8).
// Only the Argon2 hash of the refresh secret is stored, never the raw token.
/// How a device came to be trusted. Recorded honestly — nothing here may claim
/// a verification that did not happen.
enum DeviceTrustMethod {
  /// Adopted from a session that predates device identity (F1 Stage 3). We
  /// cannot say how that session was authenticated, only that it was already
  /// valid. **Never treat this as verified.**
  legacy

  /// Enrolled during a successful password login, before an OTP provider
  /// exists. A password was genuinely verified; a phone was not.
  password

  /// Stage 4 only: confirmed by a one-time code sent to the user's phone.
  /// **Nothing in Stage 3 may set this.**
  otp
}

/// A device (really: one app installation) a user has signed in from.
///
/// Recognition needs BOTH the public `id` and a high-entropy secret that is
/// returned exactly once and stored only as an Argon2id hash. The id alone
/// authenticates nothing — that is the whole point of splitting them, and it is
/// why a leaked device list cannot be replayed.
///
/// Scoped to one `(company, user)` pair. Two people sharing a handset get two
/// rows with two secrets, so nothing here can correlate a device across users
/// or companies.
///
/// Deliberately absent: IMEI, serial, advertising id, or any hardware
/// fingerprint. `label`, `platform`, `model` and `appVersion` are **untrusted
/// display metadata** the client sends for the user's benefit; no decision is
/// ever made from them.
model UserDevice {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)

  /// Argon2id hash of the server-issued credential. The raw secret exists only
  /// on the device and in the one response that issued it.
  secretHash String @map("secret_hash") @db.VarChar(255)

  /// Untrusted display metadata. Never used for authorization or recognition.
  label      String? @db.VarChar(120)
  platform   String? @db.VarChar(40)
  model      String? @db.VarChar(120)
  appVersion String? @map("app_version") @db.VarChar(40)

  trustMethod DeviceTrustMethod @map("trust_method")
  trustedAt   DateTime          @default(now()) @map("trusted_at") @db.DateTime(6)

  /// Set only when a real OTP is verified (Stage 4). Stage 3 never writes it,
  /// so "was this phone-verified?" always has a truthful answer.
  otpVerifiedAt DateTime? @map("otp_verified_at") @db.DateTime(6)

  /// An explicit logout asks for OTP re-verification next time, even on this
  /// same device. Stage 3 records the requirement; Stage 4 enforces it.
  reverifyRequired Boolean @default(false) @map("reverify_required")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.DateTime(6)
  /// Throttled — see DeviceService. Never written on every request.
  lastSeenAt  DateTime? @map("last_seen_at") @db.DateTime(6)

  /// Revoked devices are KEPT, not deleted: a security history that disappears
  /// when someone revokes a stolen phone is not a security history.
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(6)
  revokedById Bytes?    @map("revoked_by_id") @db.Binary(16)

  company  Company @relation(fields: [companyId], references: [id])
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions AuthSession[]
  otpChallenges       OtpChallenge[]
  verificationIntents VerificationIntent[]

  @@index([companyId])
  @@index([userId, revokedAt])
  @@map("user_devices")
}

model AuthSession {
  id        Bytes @id @db.Binary(16)
  companyId Bytes @map("company_id") @db.Binary(16)
  userId    Bytes @map("user_id") @db.Binary(16)

  /// The device this session belongs to (F1 Stage 3). Nullable because
  /// sessions created before Stage 3 have none and must keep working — they
  /// adopt a legacy-trusted device on their next app launch.
  deviceRecordId Bytes?      @map("device_record_id") @db.Binary(16)
  device         UserDevice? @relation(fields: [deviceRecordId], references: [id])

  /// LEGACY: the old client-supplied, unverified device string. Superseded by
  /// `deviceRecordId` and kept only so existing rows stay readable. Nothing
  /// authenticates from it.
  deviceId String? @map("device_id") @db.VarChar(120)
  deviceName       String?   @map("device_name") @db.VarChar(120)
  platform         String?   @db.VarChar(40)
  appVersion       String?   @map("app_version") @db.VarChar(40)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ip               String?   @db.VarChar(45)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(6)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Atomic per-branch sequences (invoice numbers, etc.). Incremented inside the
// owning transaction so numbers are gap-free and concurrency-safe.
model BranchCounter {
  companyId Bytes    @map("company_id") @db.Binary(16)
  branchId  Bytes    @map("branch_id") @db.Binary(16)
  kind      String   @db.VarChar(30)
  seq       BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, kind])
  @@index([companyId])
  @@map("branch_counters")
}

// --------------------------- Analytics rollups -----------------------------
// Derived/cache tables (rebuildable from sale_items/units/stock_items). No FK
// constraints by design — they are refreshed, never the source of truth.
// Analytics are tracking-type INDEPENDENT: every figure comes from sale_items,
// with category_id + tracking_type denormalized for fast grouping.

model DailyRollup {
  id          Bytes    @id @db.Binary(16)
  companyId   Bytes    @map("company_id") @db.Binary(16)
  branchId    Bytes    @map("branch_id") @db.Binary(16)
  day         DateTime @db.Date
  revenue     Decimal  @db.Decimal(14, 2)
  cogs        Decimal  @db.Decimal(14, 2)
  grossProfit Decimal  @map("gross_profit") @db.Decimal(14, 2)
  salesCount  Int      @map("sales_count")
  qtySold     Int      @map("qty_sold")
  expenses    Decimal  @db.Decimal(14, 2)
  netProfit   Decimal  @map("net_profit") @db.Decimal(14, 2)

  /// Returns APPROVED on this day (I2), stored as POSITIVE magnitudes and
  /// subtracted explicitly by every consumer. Keyed on the approval date, never
  /// the sale's day, which is what lets the original day recompute unchanged.
  ///
  /// `returnsCogs` is the original line's IMMUTABLE cost, credited back at
  /// approval — the phone is unsellable but still owned, and its cost is
  /// reinstated as faulty/return-held inventory value. Writing it to zero here
  /// would be a full write-off before anyone has inspected the phone.
  returnsRevenue     Decimal @default(0) @map("returns_revenue") @db.Decimal(14, 2)
  returnsCogs        Decimal @default(0) @map("returns_cogs") @db.Decimal(14, 2)
  /// What the shop kept back (screen protector, retained accessory). Its own
  /// component so "the refund" and "what we kept" can be reported separately.
  returnsAdjustments Decimal @default(0) @map("returns_adjustments") @db.Decimal(14, 2)
  returnsGrossProfit Decimal @default(0) @map("returns_gross_profit") @db.Decimal(14, 2)
  returnsCount       Int     @default(0) @map("returns_count")

  /// Refunds CONFIRMED on this day — cash and account movement, not profit.
  /// Profit was reversed at approval; taking it again here would double-count.
  refundsPaidTotal Decimal @default(0) @map("refunds_paid_total") @db.Decimal(14, 2)
  refundsPaidCash  Decimal @default(0) @map("refunds_paid_cash") @db.Decimal(14, 2)
  refundsPaidCount Int     @default(0) @map("refunds_paid_count")
  /// Expenses CONFIRMED for this day (Milestone D). Variable ones are keyed on
  /// their confirmation date, fixed ones on their due date — a fixed cost is
  /// never spread across every day.
  expensesCash    Decimal @default(0) @map("expenses_cash") @db.Decimal(14, 2)
  expensesCount   Int     @default(0) @map("expenses_count")
  expensesFixed   Decimal @default(0) @map("expenses_fixed") @db.Decimal(14, 2)
  /// Salaries, separately reportable from other fixed costs.
  expensesSalary  Decimal @default(0) @map("expenses_salary") @db.Decimal(14, 2)
  /// Corrections approved on this day. No profit component: a correction moves
  /// cash and liability only.
  correctionsTotal Decimal @default(0) @map("corrections_total") @db.Decimal(14, 2)
  correctionsCash  Decimal @default(0) @map("corrections_cash") @db.Decimal(14, 2)
  correctionsCount Int     @default(0) @map("corrections_count")
  refreshedAt DateTime @map("refreshed_at") @db.DateTime(6)

  @@unique([branchId, day])
  @@index([companyId, day])
  @@map("daily_rollups")
}

model ProductDailyRollup {
  id           Bytes        @id @db.Binary(16)
  companyId    Bytes        @map("company_id") @db.Binary(16)
  branchId     Bytes        @map("branch_id") @db.Binary(16)
  day          DateTime     @db.Date
  productId    Bytes        @map("product_id") @db.Binary(16)
