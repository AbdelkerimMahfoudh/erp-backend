# Staging configuration — NAMES AND SAFE DESCRIPTIONS ONLY.
#
# Copy to `.env.staging` and fill in real values there. `.env.staging` is
# git-ignored and must never be committed, baked into an image, or passed as a
# build argument.
#
# Every secret below must be generated independently. Reusing a development
# value in staging means a leak in one is a leak in both.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Environment identity ───────────────────────────────────────────────────
# Read by the reset guard, the verification-code command and /health/ready.
# Several scripts REFUSE to run unless this is exactly "staging".
APP_ENV=staging
NODE_ENV=production
PORT=3010

# Injected at build/deploy time so /health/version can answer
# "is staging running the fix?" from outside the box.
APP_COMMIT=
APP_BUILT_AT=

# ── Database ───────────────────────────────────────────────────────────────
# A DEDICATED staging database. Never the demo/development one.
# The name must contain "staging" or the reset guard refuses to touch it.
#   DATABASE_URL=mysql://<migrator-user>:<password>@<host>:3306/phonestore_staging
DATABASE_URL=
#   APP_DATABASE_URL=mysql://<app-user>:<password>@<host>:3306/phonestore_staging
APP_DATABASE_URL=
SHADOW_DATABASE_URL=

# ── Secrets — generate fresh, never reuse development values ────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Origins ────────────────────────────────────────────────────────────────
# The exact staging website origin(s). Comma-separated, no wildcard.
# With the same-origin proxy this is the one staging hostname.
CORS_ORIGINS=

# ── Behaviour ──────────────────────────────────────────────────────────────
# No demo company in staging. Synthetic data only.
SEED_DEMO=false
# The API docs are not part of a tester-facing environment.
SWAGGER_ENABLED=false
LOG_LEVEL=info

THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# ── Deliberately absent ────────────────────────────────────────────────────
# OWNER_SEED_PASSWORD — there is no demo owner in staging.
# Any payment-provider or email/WhatsApp credential — none is integrated.

# Which interface the API answers on.
#
# The invariant is that /api/* is reachable ONLY through the edge — the same
# proxy that enforces the /admin boundary and the security headers. Left open,
# the administration ENDPOINTS stay reachable on the API port even while the
# administration PAGES are refused, and the guard is then a password alone.
#
# HOW that is achieved depends on where the API runs, so declare it below with
# API_INGRESS rather than setting a bind address blindly.
#
# ⚠️ The staging stack in deploy/docker-compose.staging.yml runs the API in a
# CONTAINER with `expose` rather than `ports`. There, API_BIND must be left at
# its default: 127.0.0.1 inside a container binds the container's own loopback
# and the edge could never reach it. This file previously said to set it, which
# contradicted the compose file.

# How the API port is kept private. REQUIRED in production.
#   loopback = the API runs directly on a host it shares with the edge, and
#              API_BIND must be 127.0.0.1 — the bind address is the isolation.
#   network  = the API is in a container or on a private network, and the edge
#              is the only thing that can reach it. Leave API_BIND at its
#              default; binding loopback inside a container makes the API
#              unreachable from the edge.
# Both are supported. This also decides how many proxy hops are trusted for
# req.ip, which the rate limiter keys on. See docs/39 section 3.
API_INGRESS=network
# API_BIND=            # leave unset for the container stack
