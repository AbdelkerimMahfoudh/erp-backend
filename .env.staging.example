# The STAGING API's environment (docs/99) — NAMES, RULES AND SAFE DEFAULTS ONLY. No value here is a secret.
#
# Copy to the path STAGING_API_ENV_FILE names (e.g. /srv/erp-staging/api.env: outside the checkout, mode 600) and fill
# in there. It is never committed, never baked into an image, never passed as a build argument, and it is never the
# production file: production gets its own file, its own database and its own secrets, generated separately.
#
# deploy/staging/preflight.sh checks this file against the staging policy before every deployment, and the API's own
# production guard (staging runs NODE_ENV=production) refuses to start on most unsafe values.
#
# Generate each secret independently, never reuse one across variables or environments:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"      (48 random bytes)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"            (PLATFORM_MFA_KEY: 32 bytes)

# ── Identity ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Fixed by deploy/docker-compose.staging.yml whatever this file says: APP_ENV=staging, NODE_ENV=production, PORT=3010,
# API_INGRESS=network (the edge is the one trusted proxy hop), UPLOAD_DIR=/app/uploads. Stated here for the preflight.
APP_ENV=staging
NODE_ENV=production
PORT=3010
API_INGRESS=network
UPLOAD_DIR=/app/uploads
# The public staging API origin, no path, no trailing slash. Not read by the API itself: the preflight, the smoke test
# and the WhatsApp webhook URL derive from it, and the mobile staging build points EXPO_PUBLIC_API_ORIGIN at it.
PUBLIC_API_ORIGIN=https://staging-api.tsxmr.com
# APP_COMMIT / APP_BUILT_AT come from the image (deploy.sh stamps them from the commit). Do not set them here.

# ── Database ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Not in this file: setup-database.sh writes APP_DATABASE_URL (phonestore_app on phonestore_staging) into
# STAGING_SECRETS_DIR/database.env, which the stack reads alongside this one. The migrator's URL is only ever in
# migrator.env, which the API never sees. SHADOW_DATABASE_URL must not exist in staging.

# ── Tokens and keys (secrets: generate, 32+ characters, all different) ────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Keys every verification code (HMAC); 32+ characters. Never rotate casually: codes in flight stop matching.
OTP_PEPPER=
# Keys the recipient hashes in the messaging records; 32+ characters. Never rotate casually.
MESSAGING_HASH_KEY=
# Seals administrators' TOTP secrets: exactly 32 bytes, as 64 hex characters (or base64). Its custody is an owner
# decision (docs/77 O-C3): whoever holds it can unseal every administrator's second factor.
PLATFORM_MFA_KEY=

# ── Browser and links ──────────────────────────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials: exact https:// origins, comma-separated, no wildcard.
# Empty = none, which is right while no staging web portal exists (the mobile app is native and needs no CORS).
CORS_ORIGINS=
# The website origin the free trial's setup links are built from (docs/76): an exact https:// origin, no path. No value
# is committed (production-guard.spec.ts); the preflight refuses an empty one. Which site staging's links open is an
# owner decision (docs/99 §10): https://tsxmr.com today, a staging portal's origin once one exists.
PUBLIC_SITE_ORIGIN=
COOKIE_SECURE=true

# ── Behaviour ──────────────────────────────────────────────────────────────────────────────────────────────────────
SEED_DEMO=false
SWAGGER_ENABLED=false
# info in staging: debug logs carry request detail.
LOG_LEVEL=info
# The first platform administrator is created from the shell with MFA (docs/99 §6), never with a static key: empty.
PLATFORM_ADMIN_KEY=

# Rate limits (per client address, per API process). The edge forwards the real address; these are the defaults.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
ACCOUNT_THROTTLE_LIMIT=5
# One-time codes.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
OTP_MAX_SENDS_PER_DAY=10
# Defined for uploads; each route keeps its own, lower, limit (receipts 6 MB, receiving files 8 MB).
UPLOAD_MAX_BYTES=10485760

# Codes without a provider: "enabled" keeps each code in the API's memory (the log shows a masked contact, never the
# code) so a tester reads it with `docker compose … run --rm tools npx ts-node scripts/staging-verification-code.ts
# <contact>`; "disabled" refuses registration and sign-in codes until a channel below is live. Never a response body.
STAGING_CONTACT_OUTBOX=enabled

# ── Email (Brevo SMTP) — "disabled" until the owner supplies the ROTATED key ───────────────────────────────────────
# The Brevo SMTP key shared in chat on 2026-10-17 is compromised and is never used. To turn email on: rotate the key
# in Brevo, put the new one in SMTP_PASSWORD, and the rotation date in SMTP_KEY_ROTATED_ON (the preflight refuses
# smtp without a date after 2026-10-17). docs/98 §2 for every rule production enforces.
EMAIL_CHANNEL=disabled
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_KEY_ROTATED_ON=
EMAIL_FROM=
EMAIL_FROM_VERIFICATION=
EMAIL_FROM_NOTIFICATIONS=
EMAIL_REPLY_TO=support@tsxmr.com
EMAIL_DAILY_SAFETY_LIMIT=300
EMAIL_DAILY_RESERVE=50
EMAIL_RECIPIENT_DAILY_LIMIT=20
MESSAGE_LOG_RETENTION_DAYS=180

# ── WhatsApp (Meta Cloud API) — "disabled", or "cloud" in TEST mode to the allowlist only ─────────────────────────
# Staging never sends live: WHATSAPP_MODE=test and WHATSAPP_LIVE_SENDS=disabled are enforced by the preflight.
# The webhook Meta calls: <PUBLIC_API_ORIGIN>/api/v1/messaging/whatsapp/webhook (field "messages"); it answers 404
# until both WHATSAPP_APP_SECRET and WHATSAPP_WEBHOOK_VERIFY_TOKEN are set. docs/98 for the whole procedure.
WHATSAPP_CHANNEL=disabled
WHATSAPP_MODE=test
WHATSAPP_LIVE_SENDS=disabled
# The approved test numbers, E.164, comma-separated (personal data: only numbers whose owners agreed to receive tests).
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_AUTH_OTP=
WHATSAPP_TEMPLATE_ACCOUNT_DELETION=
WHATSAPP_TEMPLATE_ACCOUNT_DELETED=
WHATSAPP_TEMPLATE_DELIVERY_CHECK=
WHATSAPP_TEMPLATE_CLOSING_REOPENED=
WHATSAPP_TEMPLATE_CLOSING_SALE=
WHATSAPP_TEMPLATE_CLOSING_RECLOSED=
WHATSAPP_TEMPLATE_TRIAL_SETUP=
WHATSAPP_TEMPLATE_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_LANGUAGE_FR=fr
WHATSAPP_TEMPLATE_LANGUAGE_AR=ar
WHATSAPP_MAX_SENDS_PER_SECOND=20
WHATSAPP_RECIPIENT_MIN_INTERVAL_MS=1000
WHATSAPP_WEBHOOK_RETENTION_DAYS=30

# ── Background work ────────────────────────────────────────────────────────────────────────────────────────────────
# There is no switch: every API process runs the four workers (WhatsApp webhook queue, rollup outbox, recognition
# outbox, trial-end sweeper), each lease- or row-lock-guarded so a second process is safe. One API process on staging.
