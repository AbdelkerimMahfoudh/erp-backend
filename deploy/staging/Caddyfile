# The staging edge (docs/99): HTTPS for the one API hostname, then the API on the private network.
#
# - Certificates are automatic (ACME). The hostname's DNS record must point straight at this host (Cloudflare
#   "DNS only", not proxied) so the challenge reaches Caddy and so the client address below is the real one.
# - X-Forwarded-For is set to the address that connected here and nothing else: a client cannot inject its own,
#   and the API trusts exactly this one hop (API_INGRESS=network).
# - The request body passes through untouched, which the WhatsApp webhook's signature check needs (the raw bytes).
# - No access log here on purpose: the API logs every request itself with tokens scrubbed from the URL, whereas an
#   edge log would keep raw query strings (the webhook's verify token arrives in one).
{
	email {$ACME_EMAIL}
	admin off
}

{$STAGING_API_HOST} {
	request_body {
		# Above the largest upload the API accepts (an 8 MB receiving file), below anything abusive.
		max_size 16MB
	}
	reverse_proxy api:3010 {
		header_up X-Forwarded-For {remote_host}
	}
	header -Server
}

# The browser-test site (web-test.caddy), only while deploy/staging/web-test.sh has it enabled.
import /srv/erp-web/enabled/*.caddy
