# The browser-test build of the app (docs/99 §14): the Expo web export, behind a password, beside the staging API.
#
# Installed into the edge only by deploy/staging/web-test.sh, which checks every input first; without it the
# Caddyfile's import matches nothing and the edge serves the API alone.
#
# - Its own hostname, DNS only like the API's, so Caddy obtains a certificate for exactly that name. There is no other
#   alias: no platform domain, no preview address — the one name is the one door, and the door has a lock.
# - Basic authentication on every path, the app's scripts included. The password is never in the build or in Git:
#   stack.env holds its bcrypt hash only. noindex is said as well, but it is not the protection.
# - The pages are a release written by erp-mobile scripts/web-test-release.mjs: `site/` and the `routes.caddy` made
#   from it (a file that exists, then each dynamic page, then the not-found page with a 404).
{$STAGING_WEB_HOST} {
	basic_auth {
		{$STAGING_WEB_USER} {$STAGING_WEB_PASSWORD_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# The bundles are named by their content and never change; a page is asked for again every time.
	@bundle path /_expo/static/*
	header @bundle Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	root * /srv/erp-web/current/site
	import /srv/erp-web/current/routes.caddy
}
