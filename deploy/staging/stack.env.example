# The staging STACK's settings (docs/99 §3) — not the API's: those are in the API env file named below.
# Copy to deploy/staging/stack.env on the host (git-ignored) and fill in. Nothing here is a secret.

# The public API hostname. Its DNS record points at this host, DNS only (not proxied): see docs/99 §2.
STAGING_API_HOST=staging-api.tsxmr.com
# Where certificate notices go (ACME account). An address that is read.
ACME_EMAIL=

# Outside the checkout, owned by the deploying user, mode 700. setup-database.sh fills it: the five database passwords,
# the backup passphrase, and the two connection files. Back up its backup-passphrase OFF the host: without it no
# backup can be read.
STAGING_SECRETS_DIR=/srv/erp-staging/secrets
# Encrypted backups land here (and deployments.log). Copy them off the host on a schedule (docs/99 §7).
STAGING_BACKUP_DIR=/srv/erp-staging/backups
# The API's environment: a copy of .env.staging.example, filled in, mode 600, outside the checkout.
STAGING_API_ENV_FILE=/srv/erp-staging/api.env

# Not here: deploy.sh tags the images with the commit and records the running pair in
# STAGING_BACKUP_DIR/current-images.env (rollback.sh rewrites it). To deploy images built elsewhere, pass them on the
# command line: SKIP_BUILD=1 API_IMAGE=… TOOLS_IMAGE=… deploy/staging/deploy.sh
