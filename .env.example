# ---------------------------------------------------------------------------
# Dukan ERP — backend environment TEMPLATE. Copy to .env and fill in.
#
#   cp .env.example .env      # then replace every <placeholder> below
#
# NEVER commit a real .env, and never paste real values back into this file —
# it is tracked in git. Every value here is a placeholder on purpose.
#
# Target: MySQL 8.0+ (provider-generic). Locally this can be your WAMP MySQL
# on port 3306 — but nothing here depends on WAMP; any MySQL 8.0+ works.
# ---------------------------------------------------------------------------

# Migrations & seed connect as the MIGRATOR user (DDL). Used by the Prisma CLI.
DATABASE_URL="mysql://phonestore_migrator:<migrator-password>@localhost:3306/phonestore"

# Only needed for `prisma migrate dev` (a disposable shadow DB). `migrate deploy`
# does NOT need this. The migrator must be able to create/drop this database.
SHADOW_DATABASE_URL="mysql://phonestore_migrator:<migrator-password>@localhost:3306/phonestore_shadow"

# The APPLICATION RUNTIME user — DML only, no UPDATE/DELETE on audit_logs.
# Use a DIFFERENT password from the migrator: that separation is what stops a
# compromised API from altering the audit trail.
APP_DATABASE_URL="mysql://phonestore_app:<app-password>@localhost:3306/phonestore"

# Seed: the demo owner's password. Dev only — inject via a secrets manager in
# production, never from a file.
OWNER_SEED_PASSWORD="<choose-a-dev-password>"

# Seed the demo company/branch/owner? OPT-IN: only the literal "true" seeds it,
# and a production runtime refuses even then (and refuses to start with it set).
SEED_DEMO="true"

# --- Backend runtime config ---
NODE_ENV=development
PORT=3000

# Minimum 32 characters. Generate a fresh one per environment — never reuse the
# development value in production, or tokens signed in dev will validate there.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate-a-random-32-plus-character-secret>

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=
SWAGGER_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
LOG_LEVEL=debug
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./uploads

# ── Messaging + OTP (F1 Stage 4A; WhatsApp Business Cloud API since docs/64) ──
# disabled        — no network call; codes are honestly reported as undeliverable.
# development-log — prints a masked destination and the code to a local
#                   development sink. Refused in production.
# cloud           — the WhatsApp Business Cloud API (Meta Graph API) with the
#                   credentials below. The only value that delivers codes.
#                   ("cloud-api" is accepted as the same value.)
WHATSAPP_CHANNEL=disabled

# Test and live sending are separate (docs/98, D181 §4).
#   test (default) — sends ONLY to the exact numbers below, whatever the app's data says.
#   live           — may reach real customers, and only once WHATSAPP_LIVE_SENDS=enabled.
#                    Production refuses to boot in live mode unless the token is a permanent,
#                    valid system-user token (checked with Meta at start-up), the templates and
#                    the webhook are configured, and WHATSAPP_LIVE_SENDS=enabled.
WHATSAPP_MODE=test
# Comma-separated E.164 numbers, e.g. the verified test recipient(s) of the Meta test number.
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_LIVE_SENDS=disabled
# The Meta app id (an identifier, not a secret) — needed in live mode for the token check.
WHATSAPP_APP_ID=
# Outbound pacing in this process: per sending number, and a minimum gap per recipient.
WHATSAPP_MAX_SENDS_PER_SECOND=20
WHATSAPP_RECIPIENT_MIN_INTERVAL_MS=1000

# Cloud API credentials. SERVER-SIDE ONLY: never in the mobile bundle, a URL,
# a log, analytics or an audit row. Inject from a secrets manager in
# production; the placeholder values here are deliberately empty.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v26.0
# The sending number's id at Meta (an identifier, not a secret). Replace the test
# number's id with the real number's id when it is registered (docs/98 §5).
WHATSAPP_PHONE_NUMBER_ID=
# Secret: a permanent system-user token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SEND_TIMEOUT_MS=10000

# The delivery-status webhook (optional; set both or neither). The app secret
# signs every delivery; the verify token answers the one-time subscription
# check. Generate the verify token yourself:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# How long processed webhook items are kept (days; longer than Meta's retry period).
WHATSAPP_WEBHOOK_RETENTION_DAYS=30

# The provider's language codes for the approved templates (defaults shown).
WHATSAPP_TEMPLATE_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_LANGUAGE_FR=fr
WHATSAPP_TEMPLATE_LANGUAGE_AR=ar

# Approved template NAMES, one per message (docs/64 §4 has the approved copy in
# EN/FR/AR). Empty = that message cannot be sent, and the server says so
# rather than guessing. Production refuses to start with cloud-api unless the
# sign-in and account-deletion templates are both named.
WHATSAPP_TEMPLATE_ACCOUNT_DELETION=
WHATSAPP_TEMPLATE_ACCOUNT_DELETED=
WHATSAPP_TEMPLATE_CLOSING_REOPENED=
WHATSAPP_TEMPLATE_CLOSING_SALE=
WHATSAPP_TEMPLATE_CLOSING_RECLOSED=
# The operator's delivery proof (docs/64): `npm run whatsapp:prove -- --to <own number>` sends it in en, fr and ar;
# production sends no WhatsApp message until the signed webhook has reported each one delivered.
WHATSAPP_TEMPLATE_DELIVERY_CHECK=
# The portal instructions and the subscription messages (docs/101 §7): utility templates whose approved text carries the
# portal's one address, https://dukan.tsxmr.com/subscription — no token. Optional: while one is empty, WhatsApp cannot
# carry that message, the email fallback is tried (a verified email only), and the status says so.
WHATSAPP_TEMPLATE_PORTAL_INSTRUCTIONS=
WHATSAPP_TEMPLATE_TRIAL_REMINDER=
WHATSAPP_TEMPLATE_TRIAL_EXPIRED=
WHATSAPP_TEMPLATE_PAID_REMINDER=
WHATSAPP_TEMPLATE_GRACE_STARTED=
WHATSAPP_TEMPLATE_NO_GRACE=
WHATSAPP_TEMPLATE_GRACE_REMINDER=
WHATSAPP_TEMPLATE_GRACE_ENDED=

# ── Email (src/messaging/email-channel.ts, smtp-email-channel.ts) ─────────
# disabled (default) | development-log (never in production) | smtp (Brevo) | resend (dormant).
EMAIL_CHANNEL=disabled
# The fallback sender, and one sender per class (empty = EMAIL_FROM). All on a domain with SPF, DKIM and DMARC.
EMAIL_FROM=
EMAIL_FROM_VERIFICATION=
EMAIL_FROM_NOTIFICATIONS=
# Configuration only: no report or receipt email is sent (D111).
EMAIL_FROM_REPORTS=
EMAIL_FROM_RECEIPTS=
# Every email's Reply-To (the support mailbox).
EMAIL_REPLY_TO=
# SMTP relay: port 587 with STARTTLS required and TLS 1.2 minimum (not configurable).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
# Secret: the SMTP key, from the secret manager. Server-side only, never in a client, a log or a repository.
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# The application's own daily safety limit (per UTC day) and the part kept for codes. Not Brevo's account count.
EMAIL_DAILY_SAFETY_LIMIT=300
EMAIL_DAILY_RESERVE=50
EMAIL_RECIPIENT_DAILY_LIMIT=20
# Secret: server-side only, never in a client, a log or a repository.
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_SEND_TIMEOUT_MS=10000

# ── Message records (docs/98, D181 §7) ─────────────────────────────────────
# Secret: keys the recipient hashes of the email and WhatsApp records (32+ characters). Required in production
# whenever a real channel is configured. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MESSAGING_HASH_KEY=
# Message metadata (never a body, a code or a full address) is deleted after this many days.
MESSAGE_LOG_RETENTION_DAYS=180

# Server-side pepper for OTP code hashes. Six-digit codes have ~20 bits of
# entropy, so an unkeyed hash in a leaked database is brute-forceable in
# milliseconds; the pepper lives outside the database and closes that.
# Generate a long random value per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# There is deliberately NO default and NO value here. Leave it unset and OTP
# challenges refuse to activate; the rest of the app still runs.
OTP_PEPPER=
# Seals platform administrators' TOTP secrets and keys their recovery codes (0094). 32 bytes, base64 or 64 hex
# characters — generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No default: without it no administrator session can complete, and production refuses to start.
PLATFORM_MFA_KEY=
# Keys the hashes of employee invitation references (0101, D214), 32+ characters, its own value — never another
# secret's. No default: without it no invitation can be issued, and production refuses to start. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STAFF_INVITATION_KEY=

# Signs the registration links of promoters' QR cards and of user invitations (0103, D221): <PORTAL_ORIGIN>/join?r=….
# A key of its own, 32+ characters; rotating it voids every printed QR card and shared invitation. Without it promo
# codes still work but no link can be made or opened, and production refuses to start. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REFERRAL_KEY=

# ── The Dukan ERP portal (docs/101) ───────────────────────────────────────
# The portal's origin, https://dukan.tsxmr.com in production — used ONLY to write <PORTAL_ORIGIN>/subscription into the
# portal instructions and the subscription messages, and <PORTAL_ORIGIN>/join?r=… into registration links (0103), never to check where a request came from. Empty means no such
# message can be sent. Production refuses to start unless it is an https:// origin with no path (no trailing slash),
# and APP_ENV=production unless it is exactly https://dukan.tsxmr.com.
PORTAL_ORIGIN=

# OTP security limits. Server configuration, NOT Owner-editable settings.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
OTP_MAX_SENDS_PER_DAY=10

# The approved sign-in / verification code template's name at the provider.
WHATSAPP_TEMPLATE_AUTH_OTP=

# How the API port is kept private. REQUIRED in production.
#   loopback = the API runs directly on a host it shares with the edge, and
#              API_BIND must be 127.0.0.1 — the bind address is the isolation.
#   network  = the API is in a container or on a private network, and the edge
#              is the only thing that can reach it. Leave API_BIND at its
#              default; binding loopback inside a container makes the API
#              unreachable from the edge.
# Both are supported. This also decides how many proxy hops are trusted for
# req.ip, which the rate limiter keys on. See docs/39 section 3.
API_INGRESS=
API_BIND=

# ── Read by the code but set per deployment (2026-10-17 inventory; docs/99) ─────────────────────────────────────────
# The environment's identity: "staging" or unset (production). Staging runs NODE_ENV=production and this decides the
# few places staging differs (no HSTS, the staging outbox, the static provisioning key, the staging scripts' guards).
APP_ENV=
# The deployed commit and build time, stamped into the image by the deployment (GET /api/health/version).
APP_COMMIT=
APP_BUILT_AT=
# Secure cookies. Production refuses "false"; leave unset for local http development.
COOKIE_SECURE=
# Sign-up, account and trial routes: requests per minute per client (the auth routes use AUTH_THROTTLE_LIMIT).
ACCOUNT_THROTTLE_LIMIT=5
# Development and staging only: the static-key provisioning route. Empty everywhere a real administrator exists;
# production refuses to start with it set.
PLATFORM_ADMIN_KEY=
# Staging only: "enabled" lets the in-memory outbox stand in for a code provider (never in production).
STAGING_CONTACT_OUTBOX=
