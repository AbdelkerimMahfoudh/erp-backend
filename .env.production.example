# The PRODUCTION API's environment (docs/100) — NAMES, RULES AND SAFE DEFAULTS ONLY. No value here is a secret, and no
# secret is ever written into this file, even on the host: every secret is a read-only file under /run/secrets named by
# NAME_FILE (src/common/config/secret-files.ts; deploy/production/setup-secrets.sh generates them, the owner enters the
# SMTP login and key through a hidden prompt). `docker inspect` therefore shows no secret.
#
# Copy to the path API_ENV_FILE names (/srv/erp-production/api.env: outside the checkout, mode 600) and fill in there.
# deploy/production/preflight.sh checks it against the production policy before every deployment, and the API's own
# production guard refuses to start on most unsafe values.

# ── Identity ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Fixed by deploy/docker-compose.production.yml whatever this file says: APP_ENV=production, NODE_ENV=production,
# PORT=3010, API_INGRESS=network (the edge is the one trusted proxy hop), UPLOAD_DIR=/app/uploads.
APP_ENV=production
NODE_ENV=production
PORT=3010
API_INGRESS=network
UPLOAD_DIR=/app/uploads
# The public API origin, no path, no trailing slash. The preflight checks it equals https://<API_HOST of stack.env>.
PUBLIC_API_ORIGIN=https://api.tsxmr.com

# ── Secrets: files, never values (the stack names them) ────────────────────────────────────────────────────────────
#   APP_DATABASE_URL_FILE, JWT_ACCESS_SECRET_FILE, OTP_PEPPER_FILE, MESSAGING_HASH_KEY_FILE, PLATFORM_MFA_KEY_FILE,
#   STAFF_INVITATION_KEY_FILE, REFERRAL_KEY_FILE
# are set by the compose file. Do not add JWT_ACCESS_SECRET=, OTP_PEPPER=, … here: the preflight refuses a secret value.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Browser and links ──────────────────────────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials: exact https:// origins, comma-separated, no wildcard.
# Empty = none, which is right while the Dukan ERP portal is not rolled out (the mobile app is native and needs no
# CORS). Its rollout — a separate, owner-approved step — sets exactly CORS_ORIGINS=https://dukan.tsxmr.com: the portal
# signs in with HttpOnly cookies and reads its CSRF token from the API's answers, which only an allowed origin can read.
# The private test sites of persistent test businesses (D217; docs/100 §16) add their own two origins, exactly:
#   CORS_ORIGINS=https://dukan.tsxmr.com,https://erp-test.tsxmr.com,https://dukan-test.tsxmr.com
# and deploy/production/test-sites.sh refuses to enable a site whose origin is not named here.
CORS_ORIGINS=
# Customer activation (D217): closed — only persistent test businesses are created, given access and set up from the
# console. The preflight refuses "open" until the release requirements of public onboarding are met.
CUSTOMER_ACTIVATION=closed
# The portal the portal instructions and the subscription messages point to: the owner's topology (2026-10-18),
# https://dukan.tsxmr.com/subscription — the public company site, https://tsxmr.com, has no account area.
PORTAL_ORIGIN=https://dukan.tsxmr.com
COOKIE_SECURE=true

# ── Behaviour ──────────────────────────────────────────────────────────────────────────────────────────────────────
SEED_DEMO=false
SWAGGER_ENABLED=false
LOG_LEVEL=info
# The first platform administrator is created from the shell with MFA, never with a static key: empty.
PLATFORM_ADMIN_KEY=

# Rate limits (per client address, per API process). The edge forwards the real address.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
ACCOUNT_THROTTLE_LIMIT=5
# One-time codes.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
OTP_MAX_SENDS_PER_DAY=10
UPLOAD_MAX_BYTES=10485760

# ── Email (Brevo SMTP) — "disabled" until the customer-data gate is met (docs/100 §5) ───────────────────────────────
# A channel that verifies contacts lets businesses sign up: the preflight keeps it closed until an encrypted backup has
# been restored from the Storage Box. To open it: EMAIL_CHANNEL=smtp and uncomment the two _FILE lines (the owner's
# login and key, in SECRETS_DIR/api, entered through a hidden prompt — never typed here).
EMAIL_CHANNEL=disabled
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP_USERNAME_FILE=/run/secrets/smtp_username
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
EMAIL_FROM=Dukan ERP <no-reply@tsxmr.com>
EMAIL_FROM_VERIFICATION=Dukan ERP <verification@tsxmr.com>
EMAIL_FROM_NOTIFICATIONS=Dukan ERP <notifications@tsxmr.com>
EMAIL_REPLY_TO=support@tsxmr.com
EMAIL_DAILY_SAFETY_LIMIT=300
EMAIL_DAILY_RESERVE=50
EMAIL_RECIPIENT_DAILY_LIMIT=20
MESSAGE_LOG_RETENTION_DAYS=180

# ── WhatsApp (Meta Cloud API) — "disabled" (the preflight refuses anything else, docs/100 §10) ──────────────────────
WHATSAPP_CHANNEL=disabled
WHATSAPP_MODE=test
WHATSAPP_LIVE_SENDS=disabled
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v26.0

# ── Background work ────────────────────────────────────────────────────────────────────────────────────────────────
# Every API process runs the four lease- or row-lock-guarded workers. One API process on this host.
